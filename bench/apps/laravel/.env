# The app's environment, committed, as the benchmark runs it. What isn't
# here is config/'s default. php artisan optimize caches the config made
# from this file, so run setup.sh again after changing it.

# Production, with debug off, as Laravel's deployment docs say.
APP_NAME=Laravel
APP_ENV=production
APP_DEBUG=false
# APP_KEY encrypts the session's and the CSRF token's cookies. This one
# was made for the benchmark and guards nothing.
APP_KEY=base64:11MszIZmKTRtseXFvuNqeYtQTMPgeJRjkoc+H+txZl0=

# Errors only, to stderr: no line for each request.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Nothing that needs a database or Redis: the session is kept in its
# cookie, the cache, which the page doesn't use, in files, and jobs run
# as they're pushed.
SESSION_DRIVER=cookie
CACHE_STORE=file
QUEUE_CONNECTION=sync

OCTANE_SERVER=swoole
