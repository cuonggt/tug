package main

import (
	"cmp"
	"database/sql"
	"errors"
	"os"
	"time"

	"modernc.org/sqlite" // SQLite in pure Go, so the binary stays static
	sqlite3 "modernc.org/sqlite/lib"
)

// The app's database is SQLite: one file, app.db, or wherever DB_PATH
// says. This file opens it; migrations/ makes its tables, as the app starts
// (migrations.go); and the SQL of each is beside the Go that's the same on
// any database: users_db.go, passkeys_db.go, jobs_db.go, throttles_db.go,
// cache_db.go, tokens_db.go, broadcasts_db.go, notifications_db.go and
// migrations_db.go.

// dbFromEnv opens the database the environment names, DB_PATH or else
// app.db, making it when it's not there.
func dbFromEnv() (*sql.DB, error) {
	return openDB(cmp.Or(os.Getenv("DB_PATH"), "app.db"))
}

// openDB opens the SQLite database at path, making it when it's not
// there. Its journal is a write-ahead log, so pages read while a form
// writes; a write waits its turn for up to five seconds rather than fail;
// and a transaction takes the lock for writing when it begins, rather than
// fail halfway when another writer has it.
func openDB(path string) (*sql.DB, error) {
	db, err := sql.Open("sqlite", "file:"+path+"?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)&_pragma=foreign_keys(1)&_txlock=immediate")
	if err != nil {
		return nil, err
	}
	// A new database's journal becomes the log as it's first opened, which
	// two instances starting at once can't both wait for, as each would
	// wait for the other: SQLite turns one away at once. That one tries
	// again, for as long as a write waits its turn, and finds the log made.
	for until := time.Now().Add(5 * time.Second); ; time.Sleep(20 * time.Millisecond) {
		if err = db.Ping(); err == nil || !busy(err) || time.Now().After(until) {
			break
		}
	}
	if err != nil {
		db.Close()
		return nil, err
	}
	return db, nil
}

// busy reports whether err is SQLite's turning a connection away, as
// another has the lock it asked for.
func busy(err error) bool {
	var e *sqlite.Error
	return errors.As(err, &e) && e.Code()&0xff == sqlite3.SQLITE_BUSY
}
