import { createInertiaApp } from '@inertiajs/vue3'
import type { DefineComponent } from 'vue'
import AppLayout from '@/layouts/AppLayout.vue'
import AuthLayout from '@/layouts/AuthLayout.vue'
import SettingsLayout from '@/layouts/SettingsLayout.vue'
import '../css/app.css'

// Each page is its own chunk, loaded when a visit needs it. The Go server's
// root template loads the first page's alongside app.ts.
const pages = import.meta.glob<{ default: DefineComponent }>('./pages/**/*.vue')

// createApp makes the app. In the browser, app.ts's call renders the page,
// or takes over the HTML the server rendered of it; on the server, with
// server-side rendering, ssr.ts's returns what renders a page to HTML.
export function createApp() {
  return createInertiaApp({
    title: (title) => (title ? `${title} · [[ .Name ]]` : '[[ .Name ]]'),
    resolve: async (name) => {
      const load = pages[`./pages/${name}.vue`]
      if (!load) {
        throw new Error(`There's no page component at resources/js/pages/${name}.vue`)
      }
      return (await load()).default
    },
    // A page's layout goes by its name: the card for logging in and the
    // rest of Auth/, the settings' own inside the app's for Settings/, and
    // the app's for the others. Home is the landing page, which has none.
    // A page gives its layout props with a layout option of its own, as
    // Login's defineOptions({ layout: { title, description } }) does.
    layout: (name) => {
      if (name === 'Home') return null
      if (name.startsWith('Auth/')) return AuthLayout
      if (name.startsWith('Settings/')) return [AppLayout, SettingsLayout]
      return AppLayout
    },
    progress: { color: '#737373' },
  })
}
