package main

import (
	"context"
	"database/sql"
	"log/slog"
	"mime/multipart"
	"net/url"
	"strconv"
	"strings"
	"time"

	"github.com/cuonggt/tug"
	"github.com/cuonggt/tug/storage"
)

// A user's photo, which they upload on the profile page, and which the user
// menu shows in place of their initials. It's kept on the app's disk: a
// directory, files/ or FILES_PATH, or with FILESYSTEM_DISK=s3, a bucket,
// as main has it. The photos are private: a page has a link of the app's
// own to one, signed for a day or two as the page renders, which redirects
// to the disk's link to it, made as the browser follows it.

// PhotoInput is what the photo form sends: a PNG, JPEG or WebP of 2 MB at
// most. What it is is told from its bytes, not its name: an SVG, which can
// hold a script, isn't a photo, whatever it's called.
type PhotoInput struct {
	Photo *multipart.FileHeader `form:"photo" validate:"required,file_max=2MB,file_type=image/png image/jpeg image/webp"`
}

// updatePhoto keeps a user's new photo in place of the one they had. A
// disk has no transactions, so the file goes on it first, under a key of
// the app's making, and is deleted again when what names it isn't kept.
// The photo it replaces is deleted by a job pushed in the transaction that
// replaces it, so it goes once the new one is kept, and not before.
func (a *app) updatePhoto(c *tug.Ctx, user *User) error {
	var in PhotoInput
	if err := c.BindValid(&in); err != nil {
		return err
	}
	key, err := storage.PutUpload(c.Context(), a.disk, "photos", in.Photo)
	if err != nil {
		return err
	}
	if err := a.replacePhoto(c.Context(), user.ID, key); err != nil {
		if err := a.disk.Delete(context.WithoutCancel(c.Context()), key); err != nil {
			slog.ErrorContext(c.Context(), "a photo that nothing names couldn't be deleted", "key", key, "err", err)
		}
		return err
	}
	Success.Set(c, "Photo saved.")
	return c.RedirectRoute("profile.edit")
}

// removePhoto takes a user's photo away, and their initials are back.
func (a *app) removePhoto(c *tug.Ctx, user *User) error {
	if err := a.replacePhoto(c.Context(), user.ID, ""); err != nil {
		return err
	}
	Success.Set(c, "Photo removed.")
	return c.RedirectRoute("profile.edit")
}

// replacePhoto stores where a user's photo is kept, or that they have none,
// and pushes the job that deletes the one before, in one transaction.
func (a *app) replacePhoto(ctx context.Context, id int64, key string) error {
	return a.inTx(ctx, func(tx *sql.Tx) error {
		old, err := a.users.in(tx).setPhoto(ctx, id, key)
		if err != nil || old == "" {
			return err
		}
		return a.deleteFile.In(a.jobs.in(tx)).Push(ctx, DeleteFile{Key: old})
	})
}

// DeleteFile is the job that deletes a file from the app's disk once
// nothing names it: a photo that's been replaced, or removed, or whose
// account is gone. A disk that's down for a moment has it run again.
type DeleteFile struct {
	Key string `json:"key"`
}

// deleteStoredFile runs DeleteFile jobs.
func (a *app) deleteStoredFile(ctx context.Context, job DeleteFile) error {
	return a.disk.Delete(ctx, job.Key)
}

// withPhoto gives u, as the pages show them, a link to their photo: the
// app's own, at /photos, which showPhoto answers. It's signed to work
// until the end of the next day, in UTC, which is the same link all day,
// so the browser keeps the photo cached from page to page, where a link
// made afresh each time would be fetched afresh too. A link that can't be
// made shows as no photo.
func (a *app) withPhoto(ctx context.Context, u *User) {
	name, ok := strings.CutPrefix(u.PhotoKey, "photos/")
	if !ok {
		return
	}
	expires := time.Now().UTC().Truncate(24 * time.Hour).Add(48 * time.Hour)
	link, err := a.routes.SignedURL("photos.show", expires, name)
	if err != nil {
		slog.ErrorContext(ctx, "a link to a user's photo couldn't be made", "user", u.ID, "err", err)
		return
	}
	// The page's own address, which its Content-Security-Policy lets
	// images come from, whatever APP_URL's host is.
	if signed, err := url.Parse(link); err == nil {
		link = signed.RequestURI()
	}
	u.Photo = &link
}

// showPhoto answers a link withPhoto made with the disk's own link to the
// photo, made as it's followed. A bucket's link signed with a role's keys,
// as an app on EC2, ECS or EKS has, dies with them, hours on, whatever it
// says, and a page in the browser's history, or open for hours, holds the
// app's link, which works for as long as it says. The disk's link expires
// as the app's does, so it's the same all day too, and the browser keeps
// the photo cached by it, until the keys turn over and the link with them,
// which is why the redirect isn't kept.
func (a *app) showPhoto(c *tug.Ctx) error {
	unix, err := strconv.ParseInt(c.Query("expires"), 10, 64)
	if err != nil {
		return err // tug.Signed has read it already
	}
	link, err := a.disk.URL(c.Context(), "photos/"+c.Param("name"), time.Unix(unix, 0))
	if err != nil {
		return err
	}
	c.Response().Header().Set("Cache-Control", "no-store")
	return c.Redirect(link)
}
