package main

import (
	"net/http"
	"strings"
	"testing"

	"github.com/cuonggt/tug/tugtest"
)

func TestSettingsStartAtTheProfile(t *testing.T) {
	app := newTestApp(t)
	c := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	if r := c.Get("/settings"); r.Location() != "/settings/profile" {
		t.Fatalf("settings: %v", r)
	}
	if u := tugtest.Props(c.Get("/settings/profile"), Profile).User; u.Email != "ann@example.com" {
		t.Errorf("the profile's user: %+v", u)
	}
	if r := c.Get("/settings/appearance"); r.Page.Component != "Settings/Appearance" {
		t.Errorf("appearance: %v", r)
	}
}

func TestANewEmailIsntVerifiedUntilItsLinkIsFollowed(t *testing.T) {
	app := newTestApp(t)
	c := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	c.Get("/settings/profile")
	r := c.Patch("/settings/profile", map[string]any{"name": "Ann Lee", "email": "ann@elsewhere.example"})
	if r.Location() != "/settings/profile" {
		t.Fatalf("saving: %v, errors %v", r, r.Follow().Errors())
	}
	r = r.Follow()
	if u := tugtest.Props(r, Profile).User; u.Name != "Ann Lee" || u.Email != "ann@elsewhere.example" || u.EmailVerifiedAt != nil {
		t.Errorf("the profile after: %+v", u)
	}
	if r.Page.Flash["success"] != "Profile saved. We've mailed a link to ann@elsewhere.example to verify it." {
		t.Errorf("flash %v", r.Page.Flash)
	}
	m := app.outbox.Next(t)
	if m.To[0] != "ann@elsewhere.example" {
		t.Fatalf("the link went to %v", m.To)
	}
	if r := c.Get("/dashboard"); r.Location() != "/verify-email" {
		t.Errorf("the dashboard with the new email: %v", r)
	}
	c.Get(link(t, m, "/verify-email/"))
	if r := c.Get("/dashboard"); r.Page.Component != "Dashboard" {
		t.Errorf("the dashboard, verified again: %v", r)
	}
}

func TestTheSameEmailInAnotherCaseStaysVerified(t *testing.T) {
	app := newTestApp(t)
	c := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	r := c.Patch("/settings/profile", map[string]any{"name": "Ann", "email": "Ann@Example.com"}).Follow()
	if u := tugtest.Props(r, Profile).User; u.EmailVerifiedAt == nil || r.Page.Flash["success"] != "Profile saved." {
		t.Errorf("user %+v, flash %v", u, r.Page.Flash)
	}
	app.outbox.None(t)
}

func TestAnEmailWithAnAccountCantBeTaken(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	c := app.verifiedUser("Bob", "bob@example.com", "correct horse")
	c.Get("/settings/profile")
	r := c.Patch("/settings/profile", map[string]any{"name": "Bob", "email": "ANN@example.com"}).Follow()
	if u := tugtest.Props(r, Profile).User; r.Errors()["email"] != "email has an account already" || u.Email != "bob@example.com" {
		t.Errorf("errors %v, user %+v", r.Errors(), u)
	}
}

func TestChangingThePasswordTakesTheCurrentOneAndLogsOutTheOtherSessions(t *testing.T) {
	app := newTestApp(t)
	laptop := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	phone := app.client()
	logIn(phone, "ann@example.com", "correct horse")
	phone.Get("/settings/security")

	change := map[string]any{"current_password": "wrong horse", "password": "battery staple", "password_confirmation": "battery staple"}
	if errs := phone.Put("/settings/password", change).Follow().Errors(); errs["current_password"] != "that isn't your password" {
		t.Fatalf("errors %v", errs)
	}
	change["current_password"] = "correct horse"
	r := phone.Put("/settings/password", change)
	if r.Location() != "/settings/security" {
		t.Fatalf("changing: %v", r)
	}
	if r = r.Follow(); r.Page.Component != "Settings/Security" || r.Page.Flash["success"] == nil {
		t.Errorf("this browser, after: %v, flash %v", r, r.Page.Flash)
	}
	if r := laptop.Get("/dashboard"); r.Location() != "/login" {
		t.Errorf("the other session is still logged in: %v", r)
	}
	if r := logIn(app.client(), "ann@example.com", "battery staple"); r.Location() != "/dashboard" {
		t.Errorf("the new password doesn't log in: %v", r)
	}
}

func TestDeletingTheAccountTakesThePassword(t *testing.T) {
	app := newTestApp(t)
	c := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	other := app.client()
	logIn(other, "ann@example.com", "correct horse")

	c.Get("/settings/profile")
	if r := c.Delete("/settings/profile", map[string]any{"password": "wrong horse"}).Follow(); r.Errors()["password"] != "that isn't your password" || user(r) == nil {
		t.Fatalf("errors %v, user %+v", r.Errors(), user(r))
	}
	r := c.Delete("/settings/profile", map[string]any{"password": "correct horse"})
	if r.Location() != "/" {
		t.Fatalf("deleting: %v", r)
	}
	if r = r.Follow(); user(r) != nil || r.Page.Flash["success"] != "Your account is deleted." || !r.Page.ClearHistory {
		t.Errorf("after: user %+v, flash %v, clearHistory %v", user(r), r.Page.Flash, r.Page.ClearHistory)
	}
	if r := other.Get("/dashboard"); r.Location() != "/login" {
		t.Errorf("the other session outlived the account: %v", r)
	}
	if errs := logIn(other, "ann@example.com", "correct horse").Follow().Errors(); errs["email"] != "the email and password don't match an account" {
		t.Errorf("logging in to the deleted account: errors %v", errs)
	}
	// The email is free for someone new.
	if r := register(app.client(), "Ann", "ann@example.com", "correct horse"); r.Location() != "/dashboard" {
		t.Errorf("registering the email again: %v", r)
	}
}

func TestTooManyWrongPasswordsInTheSettingsWaitAMinute(t *testing.T) {
	app := newTestApp(t)
	c := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	for range 5 {
		c.Delete("/settings/profile", map[string]any{"password": "wrong horse"})
	}
	c.Delete("/settings/profile", map[string]any{"password": "correct horse"})
	r := c.Get("/settings/profile")
	if msg := r.Errors()["password"]; !strings.HasPrefix(msg, "too many tries: wait ") || user(r) == nil {
		t.Errorf("errors %v, user %+v", r.Errors(), user(r))
	}
}

func TestSecurityIsForVerifiedEmailsAndTheProfileIsnt(t *testing.T) {
	app := newTestApp(t)
	c := app.client()
	register(c, "Ann", "ann@example.com", "correct horse")
	if r := c.Get("/settings/security"); r.Location() != "/verify-email" {
		t.Errorf("security, unverified: %v", r)
	}
	// Someone who typed their email wrong can put it right.
	if r := c.Get("/settings/profile"); r.Code != http.StatusOK || r.Page.Component != "Settings/Profile" {
		t.Errorf("the profile, unverified: %v", r)
	}
}
