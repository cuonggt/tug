package main

import (
	"bytes"
	"html/template"

	"github.com/cuonggt/tug/lang"
	"github.com/cuonggt/tug/mail"
)

// words are the app's words in a language, for what has no request to say
// it in: a job that makes a mail in the language its user keeps.
func (a *app) words(locale string) lang.Words {
	return a.lang.In(locale)
}

// message is a mail of the app's to a user: a greeting, what it's about, a
// link to follow, and what to do if it wasn't them. It goes as plain text,
// and as HTML with the link as a button, for the mail programs that show
// HTML.
type message struct {
	To      *User
	Words   lang.Words // what it's said in: the greeting and the fallback line below
	Subject string
	Intro   string // before the link
	Action  string // the link's button
	URL     string
	Outro   string // after the link
}

// said is m in words, for a mail a notice makes, which says its own
// fields and leaves the rest to the template.
func (m message) said(w lang.Words) message {
	m.Words = w
	return m
}

// Greeting and Fallback are the template's own words, in the language the
// rest of the mail is said in.
func (m message) Greeting() string {
	return m.Words.T("Hi :name,", "name", m.To.Name)
}

func (m message) Fallback() string {
	return m.Words.T("If the button doesn't work, copy this link into your browser: :url", "url", m.URL)
}

func (m message) mail() mail.Message {
	var html bytes.Buffer
	if err := mailHTML.Execute(&html, m); err != nil {
		panic(err) // only for a template that doesn't fit message, found by the tests
	}
	return mail.Message{
		To:      []string{m.To.Email},
		Subject: m.Subject,
		Text:    m.Greeting() + "\n\n" + m.Intro + "\n\n" + m.Action + ":\n\n" + m.URL + "\n\n" + m.Outro + "\n\n" + appName + "\n",
		HTML:    html.String(),
	}
}

// mailHTML is a message's HTML, with its style inline, as mail programs
// take it. html/template escapes what the user typed, such as their name.
var mailHTML = template.Must(template.New("mail").Parse(`<!doctype html>
<html>
<body style="margin:0;padding:32px 16px;background:#f5f5f5;font-family:ui-sans-serif,system-ui,sans-serif;color:#171717">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0"><tr><td align="center">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:480px;background:#ffffff;border:1px solid #e5e5e5;border-radius:12px">
<tr><td style="padding:32px">
<p style="margin:0 0 24px;font-size:14px;font-weight:600">{{ .AppName }}</p>
<p style="margin:0 0 16px;font-size:15px;line-height:1.6">{{ .Greeting }}</p>
<p style="margin:0 0 24px;font-size:15px;line-height:1.6">{{ .Intro }}</p>
<p style="margin:0 0 24px"><a href="{{ .URL }}" style="display:inline-block;padding:10px 18px;background:#171717;color:#ffffff;border-radius:8px;font-size:14px;font-weight:500;text-decoration:none">{{ .Action }}</a></p>
<p style="margin:0 0 16px;font-size:13px;line-height:1.6;color:#737373">{{ .Outro }}</p>
<p style="margin:0;font-size:12px;line-height:1.6;color:#a3a3a3;word-break:break-all">{{ .Fallback }}</p>
</td></tr>
</table>
</td></tr></table>
</body>
</html>
`))

// AppName is the app's name, for the template.
func (message) AppName() string { return appName }
