// Command [[ .Name ]] is a tug app: Go handlers, [[ .Framework ]] pages, and Inertia in
// between, with accounts. People register and verify their email, log in,
// with a code from their phone too once they turn that on, and change
// their profile and photo, password and appearance in their settings.
//
//	tug dev      run it, rebuilt and reloaded as it changes
//	tug build    build it into one binary, frontend and all
package main

import (
	"cmp"
	"context"
	"database/sql"
	"embed"
	"errors"
	"io/fs"
	"log"
	"net/http"
	"os"
	"strconv"
	"strings"
	"time"

	"github.com/cuonggt/tug"
	"github.com/cuonggt/tug/auth"
	"github.com/cuonggt/tug/broadcast"
	"github.com/cuonggt/tug/cache"
	"github.com/cuonggt/tug/inertia"
	"github.com/cuonggt/tug/lang"
	"github.com/cuonggt/tug/mail"
	"github.com/cuonggt/tug/middleware"
	"github.com/cuonggt/tug/migrate"
	"github.com/cuonggt/tug/queue"
	"github.com/cuonggt/tug/session"
[[- if .SSR ]]
	"github.com/cuonggt/tug/ssr"
[[- end ]]
	"github.com/cuonggt/tug/storage"
	"github.com/cuonggt/tug/vite"
)

// appName is the app's name: on every page, in its mail, and in the
// authenticator apps that make its two-factor codes.
const appName = "[[ .Name ]]"

//go:embed app.html
var rootTemplate string

// langFiles are the app's languages, in lang/: see newApp. The .gitkeep
// lets it compile before there's one.
//
//go:embed all:lang
var langFiles embed.FS

// public is what the frontend's build writes to public/build, and anything
// else public/ holds. The .gitkeep lets it compile before the first build.
//
//go:embed all:public
var public embed.FS
[[- if .SSR ]]

// ssrBuild is what `vite build --ssr` writes to ssr/build: the pages, for
// Node to render on the server. The .gitkeep lets it compile before the
// first build.
//
//go:embed all:ssr
var ssrBuild embed.FS
[[- end ]]

func main() {
	keys, err := session.KeysFromEnv()
	if err != nil {
		log.Fatal(err)
	}
	build, err := fs.Sub(public, "public/build")
	if err != nil {
		log.Fatal(err)
	}
[[- if .SSR ]]
	bundle, err := fs.Sub(ssrBuild, "ssr/build")
	if err != nil {
		log.Fatal(err)
	}
[[- end ]]
	mailer, err := mail.FromEnv()
	if err != nil {
		log.Fatal(err)
	}
	// The database, db.go, with its tables brought up to date by the
	// migrations that haven't run, but by the migrate command, which runs
	// them itself: migrations.go. tug gen, which runs main to learn the
	// pages and routes, needs none.
	var db *sql.DB
	if !tug.Generating() {
		if db, err = dbFromEnv(); err != nil {
			log.Fatal(err)
		}
		defer db.Close()
		if !migrating() {
			if err := upToDate(context.Background(), db); err != nil {
				log.Fatal(err)
			}
		}
	}
	// The files people upload, their photos, are kept in files/, or
	// FILES_PATH, and served at /files by links signed with the app's key,
	// unless FILESYSTEM_DISK=s3 keeps them in a bucket.
	disk, err := storage.FromEnv(&storage.Local{Dir: cmp.Or(os.Getenv("FILES_PATH"), "files"), BaseURL: "/files", Keys: keys})
	if err != nil {
		log.Fatal(err)
	}
	workers, err := strconv.Atoi(cmp.Or(os.Getenv("QUEUE_WORKERS"), "4"))
	if err != nil || workers < 0 {
		log.Fatal("QUEUE_WORKERS is how many jobs the app runs at once, such as 4, or 0 for none")
	}
	// A job takes the ID of the request that pushed it, for its log lines
	// to be matched with the request's.
	q := queue.New(queue.Config{Store: &jobs{db: db}, Workers: workers, Carry: []queue.Carrier{middleware.CarryRequestID}})
	// Events, to the pages open on any instance, which the database carries
	// between them: broadcasts.go.
	hub := &broadcast.Hub{Store: &broadcasts{db: db}}
	app, err := newApp(tug.ConfigFromEnv(), env{
		Build: build, Keys: keys, DB: db, Disk: disk, Mailer: mailer, Queue: q, Hub: hub,
[[- if .SSR ]]
		SSR: bundle,
[[- end ]]
	})
	if err != nil {
		log.Fatal(err)
	}
	// The jobs run beside the server, and Run waits for the ones running
	// as it stops. An instance with none leaves its jobs to the others on
	// the database. Given a command, as ./blog jobs, Run runs it in place
	// of the server, and of the jobs.
	if workers > 0 {
		app.Go(q.Run)
	}
	app.Go(hub.Run)
	if err := app.Run(); err != nil {
		log.Fatal(err)
	}
}

// env is what the app is made from: main's comes from the environment, and
// the tests make their own.
type env struct {
	Build  fs.FS        // the frontend's build
	Keys   [][]byte     // encrypt the sessions and two-factor secrets, and sign the links in mail and to photos
	DB     *sql.DB      // nil under tug gen, which serves nothing
	Disk   storage.Disk // keeps the files people upload: their photos
	Mailer mail.Mailer

	// Queue is where the app pushes its background jobs, its mail, and what
	// runs them: main runs it beside the server, and the tests on its own.
	Queue *queue.Queue

	// Hub carries events to the pages open on any of the app's instances,
	// which main runs beside the server, and the tests on its own.
	Hub *broadcast.Hub
[[- if .SSR ]]

	// SSR is the SSR build: the pages, for Node to render on the server.
	// Without it, as in the tests, they render in the browser alone.
	SSR fs.FS
[[- end ]]
}

// app is what the handlers share.
type app struct {
	db            *sql.DB
	queue         *queue.Queue
	jobs          *jobs
	users         *users
	disk          storage.Disk
	mailer        mail.Mailer
	site          *auth.Passkeys // the site passkeys are made for, the app's: passkeys.go
	routes        *tug.App       // for the links in mail, which jobs make with no request
	verifyMail    *queue.Kind[VerifyMail]
	resetMail     *queue.Kind[ResetMail]
	deleteFile    *queue.Kind[DeleteFile]
	passkeys      *passkeys
	resets        *auth.Resets
	verifications *auth.Verifications
	twoFactor     *auth.TwoFactor

	// cache keeps what's slow to work out for a while, in the database,
	// where every instance of the app finds it, and has locks for what
	// mustn't run twice at once, on any of them: cache_db.go. The starter
	// keeps nothing in it; it's there for the app.
	cache *cache.Cache

	// What happened to each user's account, which they're told of in the
	// app and by mail, by a job: notifications.go.
	notifications    *notifications
	notificationMail *queue.Kind[NotificationMail]

	// hub carries events to the pages open on any instance, through the
	// database, broadcasts, which a handler's transaction publishes in with
	// a.hub.In(a.broadcasts.in(tx)): broadcasts.go.
	hub        *broadcast.Hub
	broadcasts *broadcasts

	// The users' API tokens: accessTokens makes a token and its hash, which
	// apiTokens keeps, and each token has apiRequests a minute: tokens.go.
	accessTokens *auth.AccessTokens
	apiTokens    *apiTokens
	apiRequests  *auth.Throttle

	// Tries, counted so that none can be made fast enough to guess: logins
	// by email and address; the password of someone logged in, and the
	// codes of a login waiting for its second factor, by user; and mail,
	// by what it's for and to whom, so that no one's inbox can be flooded,
	// and the asks for a reset link, which are jobs, by address. They're
	// counted in the database, where every instance of the app counts:
	// throttles_db.go.
	logins    *auth.Throttle
	passwords *auth.Throttle
	codes     *auth.Throttle
	mails     *auth.Throttle
	resetAsks *auth.Throttle
}

// inTx runs fn in one transaction, which it commits, and then wakes the
// queue: what fn writes through the stores in(tx) makes, the jobs it
// pushes about it with Kind.In(a.jobs.in(tx)), and the events it
// publishes with a.hub.In(a.broadcasts.in(tx)), are kept together, or not
// at all. fn writes through tx alone, as a write outside it may wait for
// it, and does no slow work, such as hashing a password: the transaction
// holds what it writes until it ends,
[[- if .SQLite ]] and in SQLite, which has one
// writer, it takes the lock for writing as it begins, which holds up
// every other write.
[[- else ]] which holds up the other writes to
// the same rows.
[[- end ]]
func (a *app) inTx(ctx context.Context, fn func(tx *sql.Tx) error) error {
	tx, err := a.db.BeginTx(ctx, nil)
	if err != nil {
		return err
	}
	defer tx.Rollback()
	if err := fn(tx); err != nil {
		return err
	}
	if err := tx.Commit(); err != nil {
		return err
	}
	a.queue.Wake()
	return nil
}

// newApp puts the app together: its pages, sessions, middleware and routes.
func newApp(cfg tug.Config, e env) (*tug.App, error) {
	if cfg.URL == "" && !tug.Generating() {
		// The links in mail, and the site passkeys are made for, are the
		// app's own address: a link made from the request's Host could point
		// anywhere, as anyone can send a request that names their own site.
		return nil, errors.New("APP_URL isn't set: the app's links in mail, and its passkeys, need its address, such as https://example.com, which tug dev sets")
	}
	assets, err := vite.New(vite.Config{Build: e.Build, HotFile: "public/hot"})
	if err != nil {
		return nil, err
	}
[[- if .SSR ]]
	// A first visit's page renders on the server: through Vite's dev server
	// under tug dev, and otherwise through Node, which runs the SSR bundle
	// beside the app, or the SSR server at SSR_URL. Without them, as before
	// the first build, it renders in the browser alone, as later visits do.
	server := &ssr.Server{Bundle: e.SSR, Node: os.Getenv("SSR_NODE")}
[[- end ]]
	pages, err := inertia.New(inertia.Config{
		Template: rootTemplate,
		Funcs:    assets.Funcs(),
		Version:  assets.Version(),
		// The pages the browser keeps for Back are encrypted, with a key
		// that logging out throws away, so the next person at the browser
		// can't go Back to the last one's.
		EncryptHistory: true,
		Title:          pageTitle,
[[- if .SSR ]]
		SSR:            &ssr.Gateway{DevServer: assets.DevServer, Server: server, URL: os.Getenv("SSR_URL")},
[[- end ]]
	})
	if err != nil {
		return nil, err
	}
	// Behind a proxy that ends TLS, requests reach the app over plain HTTP:
	// an https:// APP_URL says the cookie is for HTTPS all the same.
	sessions, err := session.New(session.Config{Keys: e.Keys, Secure: strings.HasPrefix(cfg.URL, "https://")})
	if err != nil {
		return nil, err
	}
	counts := &throttles{db: e.DB}
	cached := &cacheTable{db: e.DB}
	a := &app{
		db:            e.DB,
		queue:         e.Queue,
		jobs:          &jobs{db: e.DB},
		users:         &users{db: e.DB},
		passkeys:      &passkeys{db: e.DB},
		disk:          e.Disk,
		mailer:        e.Mailer,
		site:          passkeySite(cfg.URL),
		resets:        &auth.Resets{Keys: e.Keys},
		verifications: &auth.Verifications{Keys: e.Keys},
		twoFactor:     &auth.TwoFactor{Keys: e.Keys, Issuer: appName},
		cache:         &cache.Cache{Store: cached},
		hub:           e.Hub,
		broadcasts:    &broadcasts{db: e.DB},
		accessTokens:  &auth.AccessTokens{Prefix: tokenPrefix},
		apiTokens:     &apiTokens{db: e.DB},
		notifications: &notifications{db: e.DB},
		apiRequests:   &auth.Throttle{Name: "api", Max: 60, Window: time.Minute, Store: counts},
		logins:        &auth.Throttle{Name: "logins", Max: 5, Window: time.Minute, Store: counts},
		passwords:     &auth.Throttle{Name: "passwords", Max: 5, Window: time.Minute, Store: counts},
		codes:         &auth.Throttle{Name: "codes", Max: 5, Window: time.Minute, Store: counts},
		mails:         &auth.Throttle{Name: "mails", Max: 1, Window: time.Minute, Store: counts},
		resetAsks:     &auth.Throttle{Name: "reset-asks", Max: 5, Window: time.Minute, Store: counts},
	}
	// The mail goes by jobs, which make each mail as it goes: in verify.go,
	// auth.go and notifications.go. So do the files that nothing names any
	// more, such as a replaced photo: photos.go. Every night, a job deletes
	// the jobs that failed for good over a month ago: prune, in jobs_db.go,
	// and another the notifications read three months ago; and every hour,
	// the throttles' counts that count nothing any more, and what the cache
	// kept that has expired.
	a.verifyMail = queue.Handle(e.Queue, "verify-mail", a.mailVerification)
	a.resetMail = queue.Handle(e.Queue, "reset-mail", a.mailReset)
	a.notificationMail = queue.Handle(e.Queue, "notification-mail", a.mailNotification)
	a.deleteFile = queue.Handle(e.Queue, "delete-file", a.deleteStoredFile)
	queue.Handle(e.Queue, "prune-jobs", a.jobs.prune).Schedule(queue.Cron("@daily"), struct{}{})
	queue.Handle(e.Queue, "prune-notifications", a.notifications.prune).Schedule(queue.Cron("@daily"), struct{}{})
	queue.Handle(e.Queue, "prune-throttles", counts.prune).Schedule(queue.Every(time.Hour), struct{}{})
	queue.Handle(e.Queue, "prune-cache", cached.prune).Schedule(queue.Every(time.Hour), struct{}{})
[[- if not .Postgres ]]
	// The events the hub carried go after a minute, which every instance
	// has read them in.
	queue.Handle(e.Queue, "prune-broadcasts", a.broadcasts.prune).Schedule(queue.Every(time.Minute), struct{}{})
[[- end ]]
	if len(e.Keys) > 1 && !tug.Generating() {
		// APP_KEY is new, and the old one in APP_PREVIOUS_KEYS: move the
		// two-factor secrets over to the new one before it's dropped.
		if err := a.users.resealTwoFactor(context.Background(), a.twoFactor); err != nil {
			return nil, err
		}
	}

	pages.Share("appName", appName)
	// Every page has auth.user: null for a guest, as shared here, which is
	// also where tug gen learns its type, and the user for someone who has
	// logged in, shared as each page is rendered; and can, what the user
	// may do, in abilities.go, and bell, the notifications they haven't
	// read, in notifications.go.
	pages.Share("auth", Auth{})
	pages.Share("can", Can{})
	pages.Share("bell", Bell{})
	pages.ShareFunc(a.shareAuth)

	// The app's languages: a file each in lang/, as tug lang vi writes
	// lang/vi.json, for what it says to a person, and APP_LOCALE, the one a
	// browser gets that asks for none of them. Without a file, it's English.
	words, err := fs.Sub(langFiles, "lang")
	if err != nil {
		return nil, err
	}
	if cfg.Lang, err = lang.Load(words, cmp.Or(os.Getenv("APP_LOCALE"), "en")); err != nil {
		return nil, err
	}

	// The app's keys also sign the links that tug.Signed lets through, for
	// a route of the app's that takes only those.
	cfg.Inertia, cfg.Session, cfg.ErrorPage, cfg.Keys = pages, sessions, "Error", e.Keys
	app := tug.New(cfg)
	a.routes = app
[[- if .SSR ]]
	if os.Getenv("TUG_DEV") == "" && os.Getenv("SSR_URL") == "" {
		app.Go(server.Run)
	}
[[- end ]]
	// Behind a proxy, such as a load balancer, a request comes from the
	// proxy's address: TRUSTED_PROXIES names the proxies the app believes
	// when they say whose it is, for c.IP, which the throttles count by.
	// The API, /api, takes a token, never the session's cookie, which
	// another site's page can't borrow: CSRF lets it through, and CORS lets
	// the pages of the sites CORS_ORIGINS names call it.
	//
	// Each response says what a browser may do with it: over HTTPS, keep
	// to HTTPS; and a page, run the scripts that carry its nonce, as
	// app.html's do, and what they load, with the dev server's under tug
	// dev, and show the photos of a bucket, from its own address. What it
	// blocks, the browser reports to /csp-reports, which the app logs.
	var photos []string
	if bucket, ok := e.Disk.(*storage.S3); ok {
		photos = append(photos, bucket.Origin())
	}
	app.Use(
		middleware.TrustProxies(strings.Split(os.Getenv("TRUSTED_PROXIES"), ",")...),
		middleware.RequestID(), middleware.Logger(), middleware.Recover(),
		middleware.Headers(middleware.HeadersConfig{HSTS: strings.HasPrefix(cfg.URL, "https://")}),
		middleware.CSP(middleware.CSPConfig{
			ReportPath: "/csp-reports",
			Sources:    map[string][]string{"img-src": photos},
			DevServer:  assets.DevServer,
		}),
		middleware.CORS(strings.Split(os.Getenv("CORS_ORIGINS"), ",")...),
		middleware.CSRF("/api/"),
	)
	app.Get("/build/{path...}", tug.WrapHandler(assets))
	app.Get("/up", a.up)
	// The files on the app's own disk, at the path its links start with,
	// served only by a link that's signed: photos.go. A bucket serves its
	// own.
	if files, ok := e.Disk.(*storage.Local); ok {
		app.Get("/files/{key...}", tug.WrapHandler(files))
	}

	// The binary's commands, which Run runs in place of serving, on the
	// app's database: ./blog jobs, in jobs.go, ./blog admins, in admin.go,
	// and ./blog migrate, in migrations.go.
	app.Command("jobs", "list the jobs that failed for good; jobs retry <id>, or retry all, runs them again", func(ctx context.Context, args []string) error {
		return jobsCommand(ctx, a.jobs, os.Args[0], args, os.Stdout)
	})
	app.Command("admins", "list the admins; admins add <email>, or remove <email>, makes someone an admin or a user again", func(ctx context.Context, args []string) error {
		return adminsCommand(ctx, a.users, os.Args[0], args, os.Stdout)
	})
	app.Command("migrate", "run the migrations that haven't run; migrate status lists them, and migrate down undoes the last", func(ctx context.Context, args []string) error {
		ms, err := migrations()
		if err != nil {
			return err
		}
		return migrate.Command(ctx, &migrationsTable{db: e.DB}, ms, os.Args[0], args, os.Stdout)
	})

	app.Get("/", home).Name("home")
	app.Get("/dashboard", a.usersOnly(verified(dashboard))).Name("dashboard")

	// Registering, logging in and out, and a forgotten password: auth.go.
	app.Get("/register", a.guestsOnly(registerPage)).Name("register")
	app.Post("/register", a.guestsOnly(a.register)).Name("register.store").Takes(RegisterInput{})
	app.Get("/login", a.guestsOnly(loginPage)).Name("login")
	app.Post("/login", a.guestsOnly(a.login)).Name("login.store").Takes(LoginInput{})
	app.Post("/login/passkey/options", a.guestsOnly(a.passkeyLoginOptions)).Name("login.passkey.options")
	app.Post("/login/passkey", a.guestsOnly(a.passkeyLogin)).Name("login.passkey").Takes(PasskeyInput{})
	app.Get("/two-factor-challenge", a.guestsOnly(twoFactorChallengePage)).Name("two-factor.login")
	app.Post("/two-factor-challenge", a.guestsOnly(a.twoFactorChallenge)).Name("two-factor.login.store").Takes(TwoFactorChallengeInput{})
	app.Post("/logout", a.usersOnly(logout)).Name("logout")
	app.Get("/forgot-password", a.guestsOnly(forgotPasswordPage)).Name("password.request")
	app.Post("/forgot-password", a.guestsOnly(a.forgotPassword)).Name("password.email").Takes(ForgotPasswordInput{})
	app.Get("/reset-password/{token}", a.guestsOnly(resetPasswordPage)).Name("password.reset")
	app.Post("/reset-password", a.guestsOnly(a.resetPassword)).Name("password.store").Takes(ResetPasswordInput{})
	app.Get("/confirm-password", a.usersOnly(a.confirmPasswordPage)).Name("password.confirm")
	app.Post("/confirm-password", a.usersOnly(a.confirmPassword)).Name("password.confirm.store").Takes(ConfirmPasswordInput{})
	app.Post("/confirm-password/passkey/options", a.usersOnly(a.confirmPasskeyOptions)).Name("password.confirm.passkey.options")
	app.Post("/confirm-password/passkey", a.usersOnly(a.confirmWithPasskey)).Name("password.confirm.passkey").Takes(PasskeyInput{})
	app.Get("/verify-email", a.usersOnly(verifyEmailPage)).Name("verification.notice")
	app.Post("/verify-email", a.usersOnly(a.resendVerification)).Name("verification.send")
	app.Get("/verify-email/{id}/{token}", a.verifyEmail).Name("verification.verify")

	// The user's own events, which their pages listen for: broadcasts.go.
	app.Get("/broadcasts", a.usersOnly(a.userEvents)).Name("broadcasts")

	// What happened to the user's account: notifications.go.
	app.Get("/notifications", a.usersOnly(a.notificationsPage)).Name("notifications.index")

	// For admins alone, whom the admins command makes, as abilities.go
	// has it: the jobs that failed for good, run again: admin.go.
	app.Get("/admin/failed-jobs", a.usersOnly(verified(only(seeFailedJobs, a.failedJobsPage)))).Name("failed-jobs.index")
	app.Post("/admin/failed-jobs/retry", a.usersOnly(verified(only(seeFailedJobs, a.retryFailedJobs)))).Name("failed-jobs.retry-all")
	app.Post("/admin/failed-jobs/{id}/retry", a.usersOnly(verified(only(seeFailedJobs, a.retryFailedJob)))).Name("failed-jobs.retry")

	// Settings: settings.go, two-factor logins in twofactor.go, and passkeys
	// in passkeys.go. What could hand the account to someone else asks for
	// the password again.
	app.Get("/settings", toProfile).Name("settings")
	app.Get("/settings/profile", a.usersOnly(passwordConfirmed(profilePage))).Name("profile.edit")
	app.Patch("/settings/profile", a.usersOnly(passwordConfirmed(a.updateProfile))).Name("profile.update").Takes(ProfileInput{})
	app.Delete("/settings/profile", a.usersOnly(passwordConfirmed(a.deleteAccount))).Name("profile.destroy").Takes(DeleteAccountInput{})
	app.Post("/settings/profile/photo", a.usersOnly(passwordConfirmed(a.updatePhoto))).Name("profile.photo.update").Takes(PhotoInput{})
	app.Delete("/settings/profile/photo", a.usersOnly(passwordConfirmed(a.removePhoto))).Name("profile.photo.destroy")
	app.Get("/settings/security", a.usersOnly(verified(passwordConfirmed(a.securityPage)))).Name("security.edit")
	app.Put("/settings/password", a.usersOnly(verified(passwordConfirmed(a.updatePassword)))).Name("user-password.update").Takes(PasswordInput{})
	app.Post("/settings/two-factor", a.usersOnly(verified(passwordConfirmed(a.startTwoFactor)))).Name("two-factor.enable")
	app.Post("/settings/two-factor/confirm", a.usersOnly(verified(passwordConfirmed(a.confirmTwoFactor)))).Name("two-factor.confirm").Takes(ConfirmTwoFactorInput{})
	app.Delete("/settings/two-factor", a.usersOnly(verified(passwordConfirmed(a.stopTwoFactor)))).Name("two-factor.disable")
	app.Post("/settings/two-factor/recovery-codes", a.usersOnly(verified(passwordConfirmed(a.newRecoveryCodes)))).Name("two-factor.recovery-codes")
	app.Post("/settings/passkeys/options", a.usersOnly(verified(passwordConfirmed(a.newPasskeyOptions)))).Name("passkeys.options")
	app.Post("/settings/passkeys", a.usersOnly(verified(passwordConfirmed(a.addPasskey)))).Name("passkeys.store").Takes(NewPasskeyInput{})
	app.Delete("/settings/passkeys/{id}", a.usersOnly(verified(passwordConfirmed(a.removePasskey)))).Name("passkeys.destroy")
	app.Get("/settings/appearance", a.usersOnly(appearancePage)).Name("appearance.edit")

	// API tokens, which a user makes and revokes in their settings, and the
	// API that takes them, with no session: tokens.go.
	app.Get("/settings/tokens", a.usersOnly(verified(passwordConfirmed(a.tokensPage)))).Name("tokens.index")
	app.Post("/settings/tokens", a.usersOnly(verified(passwordConfirmed(a.createToken)))).Name("tokens.store").Takes(NewTokenInput{})
	app.Delete("/settings/tokens/{id}", a.usersOnly(verified(passwordConfirmed(a.revokeToken)))).Name("tokens.destroy")
	api := app.Group("/api")
	api.Get("/user", a.tokenUsers("user:read", apiUser)).Name("api.user")
	return app, nil
}

// NoProps are the props of a page with none of its own. It still has the
// shared ones, appName and auth.
type NoProps struct{}

var (
	Home      = tug.Page[NoProps]("Home")
	Dashboard = tug.Page[DashboardProps]("Dashboard")
)

func home(c *tug.Ctx) error {
	// The landing page's title and description, in its first visit's
	// HTML too, for a search engine, and a link's preview.
	c.Head(
		inertia.Title("Welcome"),
		inertia.Meta("description", "Go handlers render [[ .Name ]]'s pages, with Inertia in between and no API to write. "+
			"People make accounts, verify their email, and log in with a second factor if they like."),
	)
	return Home.Render(c, NoProps{})
}

// pageTitle says a page's title, as its handler gives it with c.Head, with
// the app's name after it, as [[ if .Svelte ]]resources/js/Head.svelte[[ else ]]resources/js/inertia.[[ .Script ]][[ end ]] says one in the
// browser: this says it in a first visit's HTML, which no script has run
// in yet.
func pageTitle(title string) string {
	if title == "" {
		return "[[ .Name ]]"
	}
	return title + " · [[ .Name ]]"
}

// DashboardProps are the dashboard's props: the user, who is always there,
// where the shared auth.user may be null.
type DashboardProps struct {
	User User `json:"user"`
}

func dashboard(c *tug.Ctx, user *User) error {
	return Dashboard.Render(c, DashboardProps{User: *user})
}

// up answers a load balancer's or a platform's health checks: 200 while
// the app is serving and its database answers, and a 503 when it doesn't.
func (a *app) up(c *tug.Ctx) error {
	ctx, cancel := context.WithTimeout(c.Context(), 2*time.Second)
	defer cancel()
	if err := a.db.PingContext(ctx); err != nil {
		return &tug.HTTPError{Code: http.StatusServiceUnavailable, Message: "the database isn't answering", Err: err}
	}
	return c.String(http.StatusOK, "up")
}
