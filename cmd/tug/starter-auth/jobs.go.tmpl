package main

import (
	"context"
	"database/sql"
	"fmt"
	"io"
	"strconv"
	"time"

	"github.com/cuonggt/tug/queue"
)

// jobs is where the app's background jobs wait, in its database, for tug's
// package queue, which runs them beside the server: the app's mail, which
// a mail server that's down, or the app restarting, doesn't lose, the jobs
// that run on a schedule, and those of unique kinds, whose key waits with
// them in unique_key, or stays with them in alone_key, for a kind whose
// jobs run one at a time. A job that fails for good stays for a month,
// with its error and failed_at, for the jobs command to list and run again:
// ./blog jobs, as jobsCommand has it. The tables' SQL is in jobs_db.go.
//
// run_at and held_until are Unix milliseconds, as each poll compares them
// with the time.
type jobs struct {
	db *sql.DB

	// tx is the transaction the Store that in makes pushes in; nil for the
	// app's, which pushes on its own.
	tx *sql.Tx
}

// in is the Store that pushes in tx, a handler's transaction, for
// Kind.In: its jobs are kept with what else the handler writes in tx, as
// it commits, or not at all. Its claims are the app's, which see a job
// once tx has committed.
func (s *jobs) in(tx *sql.Tx) *jobs {
	return &jobs{db: s.db, tx: tx}
}

// pushes is where s pushes a job: in its transaction, or on its own.
func (s *jobs) pushes() dbtx {
	if s.tx != nil {
		return s.tx
	}
	return s.db
}

// KeepsOneAtATime says that the table keeps a OneAtATime kind's jobs of a
// key from running at once: they keep their key in alone_key, and a claim
// passes over one whose key another held job has.
func (s *jobs) KeepsOneAtATime() {}

// aloneKey is the key a OneAtATime kind's job keeps as long as it's kept,
// or NULL for any other job's.
func aloneKey(j *queue.Job) any {
	if j.OneAtATime && j.Key != "" {
		return j.Key
	}
	return nil
}

// jobsCommand is the jobs command, name jobs, which lists the jobs that
// failed for good, and name jobs retry 42, or retry all, which puts them
// back to run from their first attempt: the app's own binary, run where it
// runs, with the database it's given. The queue of the app that serves
// runs them, as it finds them at its next poll.
func jobsCommand(ctx context.Context, s queue.FailedStore, name string, args []string, w io.Writer) error {
	switch {
	case len(args) == 0:
		failed, err := s.Failed(ctx)
		if err != nil {
			return err
		}
		if len(failed) == 0 {
			fmt.Fprintln(w, "No job has failed for good.")
			return nil
		}
		fmt.Fprintf(w, "%s failed for good, and %s kept for a month:\n\n", howMany(len(failed), "job"), plural(len(failed), "is", "are"))
		for _, j := range failed {
			fmt.Fprintf(w, "  %s  %s, which failed at %s after %s\n", j.ID, j.Kind, j.FailedAt.UTC().Format("2006-01-02 15:04:05 UTC"), howMany(j.Attempts, "attempt"))
			fmt.Fprintf(w, "      %s\n      %s\n\n", j.Payload, j.Error)
		}
		fmt.Fprintf(w, "%s jobs retry <id> runs one again, and %s jobs retry all runs them all.\n", name, name)
		return nil

	case len(args) == 2 && args[0] == "retry":
		ids := []string{args[1]}
		if args[1] == "all" {
			failed, err := s.Failed(ctx)
			if err != nil {
				return err
			}
			ids = ids[:0]
			for _, j := range failed {
				ids = append(ids, j.ID)
			}
		}
		for _, id := range ids {
			again, err := s.RunAgain(ctx, id, time.Now())
			if err != nil {
				return err
			}
			if !again {
				return fmt.Errorf("no job %s has failed for good: %s jobs lists the ones that have", id, name)
			}
		}
		fmt.Fprintf(w, "%s back to run, as the app's queue finds %s.\n", howMany(len(ids), "job"), plural(len(ids), "it", "them"))
		return nil
	}
	return fmt.Errorf("%s jobs lists the jobs that failed for good, and %s jobs retry <id>, or retry all, runs them again", name, name)
}

// howMany is n things, as a sentence says it: 1 job, 2 jobs.
func howMany(n int, thing string) string {
	return strconv.Itoa(n) + " " + plural(n, thing, thing+"s")
}

// plural is one for 1, and many for any other number.
func plural(n int, one, many string) string {
	if n == 1 {
		return one
	}
	return many
}
