func TestThePresenceKeepsItsPromises(t *testing.T) {
	broadcasttest.TestPresenceStore(t, func(t *testing.T) broadcast.PresenceStore {
		return &presences{db: testDB(t)}
	})
}

func TestTheAppsInstancesSeeEachOthersMembers(t *testing.T) {
	db := testDB(t)
	one := &broadcast.Hub{Presence: &presences{db: db}}
	other := &broadcast.Hub{Presence: &presences{db: db}}
	open, gone := context.WithCancel(t.Context())
	if _, err := one.Enter(open, broadcast.Member{ID: "ann"}, "users.1"); err != nil {
		t.Fatal(err)
	}
	here, err := other.Here(t.Context(), "users.1")
	if err != nil {
		t.Fatal(err)
	}
	if len(here) != 1 || here[0].ID != "ann" {
		t.Errorf("the other instance says who's on users.1: %+v", here)
	}

	// Her page goes, on the instance it was open on, and the other says so.
	gone()
	for deadline := time.Now().Add(10 * time.Second); ; time.Sleep(20 * time.Millisecond) {
		if here, err = other.Here(t.Context(), "users.1"); err != nil {
			t.Fatal(err)
		}
		if len(here) == 0 {
			break
		}
		if time.Now().After(deadline) {
			t.Fatalf("the other instance still says %+v is on users.1", here)
		}
	}
}

func TestThePresencePastItsLeaseIsPruned(t *testing.T) {
	ps := &presences{db: testDB(t)}
	ctx := context.Background()
	if _, err := ps.Enter(ctx, "users.1", broadcast.Member{ID: "ann"}, "ended", time.Now().Add(-time.Minute)); err != nil {
		t.Fatal(err)
	}
	if _, err := ps.Enter(ctx, "users.1", broadcast.Member{ID: "bo"}, "open", time.Now().Add(time.Minute)); err != nil {
		t.Fatal(err)
	}
	if err := ps.prune(ctx, struct{}{}); err != nil {
		t.Fatal(err)
	}
	here, err := ps.Here(ctx, "users.1")
	if err != nil {
		t.Fatal(err)
	}
	if len(here) != 1 || here[0].ID != "bo" {
		t.Errorf("who's on users.1 after the prune: %+v, want the one whose lease hasn't ended", here)
	}
	// The row is gone, not only left out of Here: nothing is there to leave.
	if left, err := ps.Leave(ctx, "users.1", "ended"); err != nil || left {
		t.Errorf("leaving the pruned connection: %v, %v", left, err)
	}
}

// The security page says which of the account's browsers have a page open
// now: another browser's page is on the user's channel while it listens,
// and off it once it has gone.
func TestTheSecurityPageSaysWhichBrowsersAreOpen(t *testing.T) {
	app := newTestApp(t)
	ann := app.verifiedUser("Ann", "ann@example.com", "correct horse")

	// Her phone, logged in to the same account, with a page open on it: a
	// stream stays open, as tugtest's client doesn't, so it goes through a
	// server of its own.
	phone := app.client()
	cookie := logIn(phone, "ann@example.com", "correct horse").Cookie("tug_session")
	if cookie == nil {
		t.Fatal("the phone isn't logged in")
	}
	srv := httptest.NewServer(app)
	defer srv.Close()
	ctx, gone := context.WithCancel(t.Context())
	defer gone() // before srv.Close, which waits for the stream
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, srv.URL+"/broadcasts", nil)
	if err != nil {
		t.Fatal(err)
	}
	req.AddCookie(cookie)
	res, err := srv.Client().Do(req)
	if err != nil {
		t.Fatal(err)
	}
	defer res.Body.Close()
	streamed(res.Body)

	// What the page shows: how many browsers, and how many of them open.
	// Her own has no page open, as the tests' client holds none.
	shown := func() (int, int) {
		t.Helper()
		props := tugtest.Props(ann.Get("/settings/security"), Security)
		opened := 0
		for _, b := range props.Browsers {
			if b.Open {
				opened++
			}
		}
		return len(props.Browsers), opened
	}
	for deadline := time.Now().Add(10 * time.Second); ; time.Sleep(20 * time.Millisecond) {
		browsers, opened := shown()
		if browsers == 2 && opened == 1 {
			break
		}
		if time.Now().After(deadline) {
			t.Fatalf("%d browsers, %d of them open: want two, and the phone's open", browsers, opened)
		}
	}

	// Its page goes, and the list says so.
	gone()
	for deadline := time.Now().Add(10 * time.Second); ; time.Sleep(20 * time.Millisecond) {
		if _, opened := shown(); opened == 0 {
			break
		}
		if time.Now().After(deadline) {
			t.Fatal("the phone's page went, and the security page still says it's open")
		}
	}
}
