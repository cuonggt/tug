// testApp is the app with a database and a disk of its own, and mail that
// goes into its outbox.
type testApp struct {
	*tug.App
	t      *testing.T
	db     *sql.DB
	keys   [][]byte
	files  string           // the directory the app's disk keeps its files in
	outbox *mailtest.Outbox // the mail the app sends, which Next reads
	hub    *broadcast.Hub   // carries the app's events, which a test can subscribe to

	// stopQueue stops the app's queue, which runs beside the test, for a
	// test that claims jobs of its own, and returns once it has.
	stopQueue func()
}

func key(b byte) []byte { return bytes.Repeat([]byte{b}, 32) }

// newTestApp is the app on a database of the test's own, testDB's.
func newTestApp(t *testing.T) *testApp {
	t.Helper()
	return startApp(t, testDB(t), [][]byte{key(1)})
}

// startApp makes the app on db, with keys, as a deploy does, and runs its
// jobs until the test ends. A job that has come due runs at once, rather
// than at the next second's poll.
func startApp(t *testing.T, db *sql.DB, keys [][]byte) *testApp {
	t.Helper()
	out := &mailtest.Outbox{}
	q := queue.New(queue.Config{Store: &jobs{db: db}, Poll: 10 * time.Millisecond, Carry: []queue.Carrier{middleware.CarryRequestID}})
	hub := &broadcast.Hub{Store: &broadcasts{db: db}}
	files := filepath.Join(t.TempDir(), "files")
	disk := &storage.Local{Dir: files, BaseURL: "/files", Keys: keys}
	app, err := newApp(tug.Config{URL: "https://app.example"}, env{Build: fstest.MapFS{}, Keys: keys, DB: db, Disk: disk, Mailer: out, Queue: q, Hub: hub})
	if err != nil {
		t.Fatal(err)
	}
	queueCtx, stopQueue := context.WithCancel(context.Background())
	queueRan := make(chan struct{})
	go func() {
		q.Run(queueCtx)
		close(queueRan)
	}()
	hubCtx, stopHub := context.WithCancel(context.Background())
	hubRan := make(chan struct{})
	go func() {
		hub.Run(hubCtx)
		close(hubRan)
	}()
	a := &testApp{App: app, t: t, db: db, keys: keys, files: files, outbox: out, hub: hub}
	a.stopQueue = func() {
		stopQueue()
		<-queueRan
	}
	t.Cleanup(func() {
		a.stopQueue()
		stopHub()
		<-hubRan
	})
	return a
}

// link returns the path of the link to path that m carries.
func link(t *testing.T, m mail.Message, path string) string {
	t.Helper()
	found := regexp.MustCompile(`https://app\.example(` + regexp.QuoteMeta(path) + `\S*)`).FindStringSubmatch(m.Text)
	if found == nil {
		t.Fatalf("no link to %s in the mail to %v:\n%s", path, m.To, m.Text)
	}
	return found[1]
}

// client is a browser with the app open, which the tests use as Inertia's
// client in it does: its visits get the pages as JSON, so the tests run
// without a frontend build. See package tugtest.
func (a *testApp) client() *tugtest.Client {
	return tugtest.New(a.t, a)
}

// user is the auth.user every page shares: the user logged in, or nil for
// a guest.
func user(r *tugtest.Response) *User {
	return tugtest.Prop[*User](r, "auth.user")
}

func register(c *tugtest.Client, name, email, password string) *tugtest.Response {
	return c.Post("/register", map[string]any{
		"name": name, "email": email, "password": password, "password_confirmation": password,
	})
}

func logIn(c *tugtest.Client, email, password string) *tugtest.Response {
	return c.Post("/login", map[string]any{"email": email, "password": password})
}

// verifiedUser registers a user and follows the link mailed to them, and
// returns the browser they did it in, logged in.
func (a *testApp) verifiedUser(name, email, password string) *tugtest.Client {
	a.t.Helper()
	c := a.client()
	if r := register(c, name, email, password); r.Location() != "/dashboard" {
		a.t.Fatalf("registering %s: %v", email, r)
	}
	if r := c.Get(link(a.t, a.outbox.NextTo(a.t, email), "/verify-email/")); r.Location() != "/dashboard" {
		a.t.Fatalf("verifying %s: %v", email, r)
	}
	return c
}

// oldLogin returns a browser logged in as the user with email, as one that
// logged in longer ago than a confirmed password lasts: the session has
// the login, and no password typed since.
func (a *testApp) oldLogin(email string) *tugtest.Client {
	a.t.Helper()
	u, err := (&users{db: a.db}).byEmail(context.Background(), email)
	if err != nil {
		a.t.Fatal(err)
	}
	sessions, err := session.New(session.Config{Keys: a.keys})
	if err != nil {
		a.t.Fatal(err)
	}
	c := a.client()
	c.Session(sessions, func(s *session.Session) { auth.Login(s, u.authID(), u.PasswordHash) })
	return c
}

func TestEveryPageKnowsWhosLoggedIn(t *testing.T) {
	app := newTestApp(t)
	c := app.client()
	if r := c.Get("/"); r.Page.Component != "Home" || user(r) != nil {
		t.Fatalf("a guest's home: %v, user %v", r, user(r))
	}
	register(c, "Ann", "ann@example.com", "correct horse")
	if r := c.Get("/nowhere"); r.Code != http.StatusNotFound || r.Page.Component != "Error" || user(r) == nil || user(r).Name != "Ann" {
		t.Errorf("a 404 while logged in: %v, user %v", r, user(r))
	}
}

func TestThePasswordHashAndTwoFactorSecretNeverReachAPage(t *testing.T) {
	app := newTestApp(t)
	c := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	c.Post("/settings/two-factor", nil)
	secret := tugtest.Props(c.Get("/settings/security"), Security).Setup.Secret
	code, _ := app.twoFactor().Code(secret, time.Now())
	c.Post("/settings/two-factor/confirm", map[string]any{"code": code})
	for _, page := range []string{"/", "/dashboard", "/settings/profile", "/settings/security"} {
		if r := c.Get(page); r.Code != http.StatusOK || strings.Contains(r.Body, "argon2id") || strings.Contains(r.Body, secret) {
			t.Errorf("%v: %s", r, r.Body)
		}
	}
}

func TestTheHealthCheckSaysTheAppIsUp(t *testing.T) {
	app := newTestApp(t)
	c := app.client()
	if r := c.Do(httptest.NewRequest("GET", "/up", nil)); r.Code != http.StatusOK || r.Body != "up" {
		t.Errorf("got %v", r)
	}
	app.db.Close()
	if r := c.Do(httptest.NewRequest("GET", "/up", nil)); r.Code != http.StatusServiceUnavailable {
		t.Errorf("with the database gone: %v", r)
	}
}

// twoFactor is the app's auth.TwoFactor, for making the codes a user's
// phone would.
func (a *testApp) twoFactor() *auth.TwoFactor {
	return &auth.TwoFactor{Keys: a.keys}
}
