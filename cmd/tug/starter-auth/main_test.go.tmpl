// outbox is a mailer that keeps what it's given, for the tests to read.
// It can be down, as a mail server can, for a number of mails.
type outbox struct {
	sent chan mail.Message
	down atomic.Int32
}

func (o *outbox) Send(ctx context.Context, m mail.Message) error {
	if o.down.Add(-1) >= 0 {
		return errors.New("dial tcp: connection refused")
	}
	select {
	case o.sent <- m:
		return nil
	case <-ctx.Done():
		return ctx.Err()
	}
}

// testApp is the app with a database of its own, and mail that goes into
// its outbox.
type testApp struct {
	*tug.App
	t      *testing.T
	db     *sql.DB
	keys   [][]byte
	outbox *outbox
}

func key(b byte) []byte { return bytes.Repeat([]byte{b}, 32) }

func newTestApp(t *testing.T) *testApp {
	t.Helper()
	return startApp(t, testDB(t), [][]byte{key(1)})
}

// testDB is a database of the test's own, with its tables made.
func testDB(t *testing.T) *sql.DB {
	t.Helper()
	db, err := openDB(filepath.Join(t.TempDir(), "app.db"))
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { db.Close() })
	return db
}

// startApp makes the app on db, with keys, as a deploy does, and runs its
// jobs until the test ends. A job that has come due runs at once, rather
// than at the next second's poll.
func startApp(t *testing.T, db *sql.DB, keys [][]byte) *testApp {
	t.Helper()
	out := &outbox{sent: make(chan mail.Message, 20)}
	q := queue.New(queue.Config{Store: &jobs{db: db}, Poll: 10 * time.Millisecond})
	app, err := newApp(tug.Config{}, env{Build: fstest.MapFS{}, Keys: keys, DB: db, Mailer: out, URL: "https://app.example", Queue: q})
	if err != nil {
		t.Fatal(err)
	}
	ctx, stop := context.WithCancel(context.Background())
	ran := make(chan struct{})
	go func() {
		q.Run(ctx)
		close(ran)
	}()
	t.Cleanup(func() {
		stop()
		<-ran
	})
	return &testApp{App: app, t: t, db: db, keys: keys, outbox: out}
}

// mail returns the next mail the app sent. A job sends it, so it may not
// be there yet when the request is answered.
func (a *testApp) mail() mail.Message {
	a.t.Helper()
	select {
	case m := <-a.outbox.sent:
		return m
	case <-time.After(5 * time.Second):
		a.t.Fatal("no mail came")
	}
	return mail.Message{}
}

// noMail checks that the app sends nothing more.
func (a *testApp) noMail() {
	a.t.Helper()
	select {
	case m := <-a.outbox.sent:
		a.t.Errorf("mail went to %v: %s", m.To, m.Subject)
	case <-time.After(100 * time.Millisecond):
	}
}

// link returns the path of the link to path that m carries.
func link(t *testing.T, m mail.Message, path string) string {
	t.Helper()
	found := regexp.MustCompile(`https://app\.example(` + regexp.QuoteMeta(path) + `\S*)`).FindStringSubmatch(m.Text)
	if found == nil {
		t.Fatalf("no link to %s in the mail to %v:\n%s", path, m.To, m.Text)
	}
	return found[1]
}

// visitor is Inertia's client in a browser: it keeps the session cookie.
// Its visits get JSON, so the tests run without a frontend build.
type visitor struct {
	t      *testing.T
	app    *testApp
	cookie *http.Cookie
}

func (a *testApp) visitor() *visitor {
	return &visitor{t: a.t, app: a}
}

// response is what a visit got back.
type response struct {
	code     int
	location string       // where a redirect goes
	cookie   *http.Cookie // the session cookie it set
	page     inertia.Page
}

// visit makes a request with body as JSON, and headers in pairs, as
// "X-Inertia-Partial-Data", "recoveryCodes".
func (v *visitor) visit(method, target string, body map[string]any, headers ...string) response {
	v.t.Helper()
	data, _ := json.Marshal(body)
	req := httptest.NewRequest(method, target, bytes.NewReader(data))
	req.Header.Set("X-Inertia", "true")
	req.Header.Set("Content-Type", "application/json")
	req.Header.Set("Referer", "http://example.com/")
	for i := 0; i+1 < len(headers); i += 2 {
		req.Header.Set(headers[i], headers[i+1])
	}
	if v.cookie != nil {
		req.AddCookie(v.cookie)
	}
	rec := httptest.NewRecorder()
	v.app.ServeHTTP(rec, req)
	r := response{code: rec.Code, location: rec.Header().Get("Location")}
	for _, c := range rec.Result().Cookies() {
		v.cookie, r.cookie = c, c
	}
	if rec.Header().Get("X-Inertia") == "true" {
		if err := json.Unmarshal(rec.Body.Bytes(), &r.page); err != nil {
			v.t.Fatal(err)
		}
	}
	return r
}

// get follows a link, or a redirect.
func (v *visitor) get(target string) response {
	v.t.Helper()
	return v.visit("GET", target, nil)
}

// errors are the validation errors a page shows.
func (r response) errors() map[string]any {
	errs, _ := r.page.Props["errors"].(map[string]any)
	return errs
}

// user is the auth.user every page shares, or nil for a guest.
func (r response) user() map[string]any {
	auth, _ := r.page.Props["auth"].(map[string]any)
	u, _ := auth["user"].(map[string]any)
	return u
}

func register(v *visitor, name, email, password string) response {
	return v.visit("POST", "/register", map[string]any{
		"name": name, "email": email, "password": password, "password_confirmation": password,
	})
}

func logIn(v *visitor, email, password string) response {
	return v.visit("POST", "/login", map[string]any{"email": email, "password": password})
}

// verifiedUser registers a user and follows the link mailed to them, and
// returns the browser they did it in, logged in.
func (a *testApp) verifiedUser(name, email, password string) *visitor {
	a.t.Helper()
	v := a.visitor()
	if r := register(v, name, email, password); r.location != "/dashboard" {
		a.t.Fatalf("registering %s: %d to %q, errors %v", email, r.code, r.location, r.errors())
	}
	if r := v.get(link(a.t, a.mail(), "/verify-email/")); r.location != "/dashboard" {
		a.t.Fatalf("verifying %s: %d to %q", email, r.code, r.location)
	}
	return v
}

// oldLogin returns a browser logged in as the user with email, as one that
// logged in longer ago than a confirmed password lasts: the session has
// the login, and no password typed since.
func (a *testApp) oldLogin(email string) *visitor {
	a.t.Helper()
	u, err := (&users{db: a.db}).byEmail(context.Background(), email)
	if err != nil {
		a.t.Fatal(err)
	}
	store, err := session.New(session.Config{Keys: a.keys})
	if err != nil {
		a.t.Fatal(err)
	}
	rec := httptest.NewRecorder()
	store.Middleware(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		auth.Login(session.From(r.Context()), u.authID(), u.PasswordHash)
		w.WriteHeader(http.StatusNoContent)
	})).ServeHTTP(rec, httptest.NewRequest("GET", "/", nil))
	return &visitor{t: a.t, app: a, cookie: rec.Result().Cookies()[0]}
}

func TestEveryPageKnowsWhosLoggedIn(t *testing.T) {
	app := newTestApp(t)
	v := app.visitor()
	if r := v.get("/"); r.page.Component != "Home" || r.user() != nil {
		t.Fatalf("a guest's home: %+v", r.page)
	}
	register(v, "Ann", "ann@example.com", "correct horse")
	if r := v.get("/nowhere"); r.code != http.StatusNotFound || r.page.Component != "Error" || r.user()["name"] != "Ann" {
		t.Errorf("a 404 while logged in: %d %+v", r.code, r.page)
	}
}

func TestThePasswordHashAndTwoFactorSecretNeverReachAPage(t *testing.T) {
	app := newTestApp(t)
	v := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	v.visit("POST", "/settings/two-factor", nil)
	secret := v.get("/settings/security").page.Props["setup"].(map[string]any)["secret"].(string)
	code, _ := app.twoFactor().Code(secret, time.Now())
	v.visit("POST", "/settings/two-factor/confirm", map[string]any{"code": code})
	for _, page := range []string{"/", "/dashboard", "/settings/profile", "/settings/security"} {
		r := v.get(page)
		props, _ := json.Marshal(r.page.Props)
		if r.code != http.StatusOK || bytes.Contains(props, []byte("argon2id")) || bytes.Contains(props, []byte(secret)) {
			t.Errorf("%s: %d %s", page, r.code, props)
		}
	}
}

func TestTheHealthCheckSaysTheAppIsUp(t *testing.T) {
	app := newTestApp(t)
	rec := httptest.NewRecorder()
	app.ServeHTTP(rec, httptest.NewRequest("GET", "/up", nil))
	if rec.Code != http.StatusOK || rec.Body.String() != "up" {
		t.Errorf("got %d %q", rec.Code, rec.Body)
	}
	app.db.Close()
	rec = httptest.NewRecorder()
	app.ServeHTTP(rec, httptest.NewRequest("GET", "/up", nil))
	if rec.Code != http.StatusServiceUnavailable {
		t.Errorf("with the database gone: %d %q", rec.Code, rec.Body)
	}
}

func TestTheMigrationsRunOnceAndLeaveANewerDatabaseAlone(t *testing.T) {
	path := filepath.Join(t.TempDir(), "app.db")
	for range 2 {
		db, err := openDB(path)
		if err != nil {
			t.Fatal(err)
		}
		var version int
		db.QueryRow("PRAGMA user_version").Scan(&version)
		db.Close()
		if version != len(migrations) {
			t.Fatalf("user_version %d, want %d", version, len(migrations))
		}
	}
	db, _ := openDB(path)
	db.Exec("PRAGMA user_version = 1000")
	db.Close()
	if db, err := openDB(path); err != nil {
		t.Errorf("a database from a newer build: %v", err)
	} else {
		db.Close()
	}
}

// twoFactor is the app's auth.TwoFactor, for making the codes a user's
// phone would.
func (a *testApp) twoFactor() *auth.TwoFactor {
	return &auth.TwoFactor{Keys: a.keys}
}
