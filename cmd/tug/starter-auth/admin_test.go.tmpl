func TestActingEndsAfterItsHourWithTheAdminsLogin(t *testing.T) {
	app := newTestApp(t)
	ann, _, bobID := adminAndBob(t, app)
	bob, err := (&users{db: app.db}).byID(context.Background(), bobID)
	if err != nil {
		t.Fatal(err)
	}
	sessions, err := session.New(session.Config{Keys: app.keys})
	if err != nil {
		t.Fatal(err)
	}
	// Acting whose hour is up, as the session has it once it is.
	ann.Session(sessions, func(s *session.Session) { auth.ActAs(s, bob.authID(), bob.PasswordHash, 0) })
	for _, page := range []string{"/dashboard", "/admin/users"} {
		if r := ann.Get(page); r.Location() != "/login" {
			t.Errorf("%s once the hour was up: %v", page, r)
		}
	}
}

func TestAnAdminMayNotSuspendOrActAsThemselvesAnotherAdminOrTheSuspended(t *testing.T) {
	app := newTestApp(t)
	ann, _, bobID := adminAndBob(t, app)
	annID := app.userID("ann@example.com")
	app.makeAdmin("bob@example.com")
	for path, want := range map[string]string{
		userPath(annID, "suspend"): "you may not suspend yourself",
		userPath(annID, "act"):     "you may not act as yourself",
		userPath(bobID, "suspend"): "you may not suspend an admin: the admins command makes them a user again first",
		userPath(bobID, "act"):     "you may not act as an admin: the admins command makes them a user again first",
	} {
		if r := ann.Post(path, nil); r.Code != 403 || tugtest.Prop[string](r, "message") != want {
			t.Errorf("%s: %v, %v", path, r, r.Page.Props)
		}
	}
	for _, u := range tugtest.Props(ann.Get("/admin/users"), Users).List.Data {
		if u.Can.Suspend || u.Can.ActAs {
			t.Errorf("the page offers to suspend or act as %+v", u)
		}
	}

	if err := adminsCommand(context.Background(), &users{db: app.db}, "./blog", []string{"remove", "bob@example.com"}, &strings.Builder{}); err != nil {
		t.Fatal(err)
	}
	ann.Post(userPath(bobID, "suspend"), nil)
	if r := ann.Post(userPath(bobID, "act"), nil); r.Code != 403 || tugtest.Prop[string](r, "message") != "you may not act as a suspended account: restore it first" {
		t.Errorf("acting as the suspended: %v", r)
	}
	if r := ann.Post(userPath(bobID+100, "suspend"), nil); r.Code != 404 {
		t.Errorf("suspending no one: %v", r)
	}
}
