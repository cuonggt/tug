func TestAJobPushedInATransactionIsKeptOnlyAsItCommits(t *testing.T) {
	db := testDB(t)
	s := &jobs{db: db}
	ctx, now := context.Background(), time.Now()
	for _, commit := range []bool{false, true} {
		tx, err := db.BeginTx(ctx, nil)
		if err != nil {
			t.Fatal(err)
		}
		j := &queue.Job{Kind: "verify-mail", Payload: []byte(fmt.Sprintf(`{"committed":%v}`, commit)), RunAt: now}
		if err := s.in(tx).Push(ctx, j); err != nil {
			t.Fatal(err)
		}
		if j, err := s.Claim(ctx, now, now.Add(time.Minute)); j != nil || err != nil {
			t.Fatalf("claimed %+v, %v, before its transaction ended", j, err)
		}
		if commit {
			err = tx.Commit()
		} else {
			err = tx.Rollback()
		}
		if err != nil {
			t.Fatal(err)
		}
	}
	j, err := s.Claim(ctx, now, now.Add(time.Minute))
	if err != nil || j == nil || string(j.Payload) != `{"committed":true}` {
		t.Fatalf("claimed %+v, %v: want the job whose transaction committed", j, err)
	}
	if again, err := s.Claim(ctx, now, now.Add(time.Minute)); again != nil || err != nil {
		t.Errorf("claimed %+v, %v, pushed in the transaction that rolled back", again, err)
	}
}

// failJob pushes a job and fails it for good, with err, as a mail to an
// address that isn't there fails.
func failJob(t *testing.T, s *jobs, payload, err string) {
	t.Helper()
	ctx, now := context.Background(), time.Now()
	s.Push(ctx, &queue.Job{Kind: "verify-mail", Payload: []byte(payload), RunAt: now})
	j, claimErr := s.Claim(ctx, now, now.Add(time.Minute))
	if claimErr != nil || j == nil {
		t.Fatalf("claimed %v, %v", j, claimErr)
	}
	j.Error = err
	if err := s.Fail(ctx, j); err != nil {
		t.Fatal(err)
	}
}

func TestTheJobsCommandListsTheJobsThatFailedAndRunsThemAgain(t *testing.T) {
	s := &jobs{db: testDB(t)}
	ctx := context.Background()
	failJob(t, s, `{"user":1}`, "550 no such mailbox: ann@example.com")
	failJob(t, s, `{"user":2}`, "550 no such mailbox: bob@example.com")
	var out strings.Builder
	if err := jobsCommand(ctx, s, "./blog", nil, &out); err != nil {
		t.Fatal(err)
	}
	for _, want := range []string{"2 jobs failed for good", "verify-mail", `{"user":1}`, "550 no such mailbox: bob@example.com", "after 1 attempt\n", "./blog jobs retry <id>"} {
		if !strings.Contains(out.String(), want) {
			t.Errorf("the list has no %q:\n%s", want, out.String())
		}
	}

	// One, and then the rest, from its first attempt.
	failed, err := s.Failed(ctx)
	if err != nil || len(failed) != 2 {
		t.Fatalf("failed: %v, %v", failed, err)
	}
	out.Reset()
	if err := jobsCommand(ctx, s, "./blog", []string{"retry", failed[1].ID}, &out); err != nil || out.String() != "1 job back to run, as the app's queue finds it.\n" {
		t.Fatalf("retry %s: %q, %v", failed[1].ID, out.String(), err)
	}
	now := time.Now().Add(time.Second)
	if j, err := s.Claim(ctx, now, now.Add(time.Minute)); err != nil || j == nil || j.ID != failed[1].ID || j.Attempts != 1 {
		t.Errorf("claimed %+v, %v: want the job run again, from its first attempt", j, err)
	}
	out.Reset()
	if err := jobsCommand(ctx, s, "./blog", []string{"retry", "all"}, &out); err != nil || !strings.HasPrefix(out.String(), "1 job back to run") {
		t.Errorf("retry all: %q, %v", out.String(), err)
	}

	if err := jobsCommand(ctx, s, "./blog", []string{"retry", failed[1].ID}, &out); err == nil || !strings.Contains(err.Error(), "no job "+failed[1].ID+" has failed for good") {
		t.Errorf("retry of a job that hasn't failed: %v", err)
	}
	if err := jobsCommand(ctx, s, "./blog", []string{"forget", "all"}, &out); err == nil || !strings.Contains(err.Error(), "./blog jobs retry <id>") {
		t.Errorf("a command that isn't one: %v", err)
	}
	out.Reset()
	if err := jobsCommand(ctx, s, "./blog", nil, &out); err != nil || out.String() != "No job has failed for good.\n" {
		t.Errorf("with none failed: %q, %v", out.String(), err)
	}
}

func TestTheBinaryRunsTheJobsCommandInPlaceOfTheServer(t *testing.T) {
	// The job fails before the app starts, as its queue would otherwise
	// claim it first, and a failed job is one no queue claims.
	db := testDB(t)
	s := &jobs{db: db}
	failJob(t, s, `{"user":1}`, "550 no such mailbox: ann@example.com")
	app := startApp(t, db, [][]byte{key(1)})
	old := os.Args
	os.Args = []string{"./blog", "jobs", "retry", "all"}
	t.Cleanup(func() { os.Args = old })
	if err := app.Run(); err != nil {
		t.Fatal(err)
	}
	if failed, err := s.Failed(context.Background()); err != nil || len(failed) != 0 {
		t.Errorf("failed after retry all: %v, %v", failed, err)
	}
}

func TestAMailThatDoesntGoIsSentAgain(t *testing.T) {
	app := newTestApp(t)
	app.outbox.Down(1)
	register(app.client(), "Ann", "ann@example.com", "correct horse")
	if m := app.outbox.Next(t); m.To[0] != "ann@example.com" || !strings.HasPrefix(m.Subject, "Verify") {
		t.Errorf("sent again: the mail to %v, %s", m.To, m.Subject)
	}
}

func TestAnAddressCanAskForFiveResetLinksAMinute(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	c := app.client()
	for i := range 5 {
		c.Post("/forgot-password", map[string]any{"email": fmt.Sprintf("nobody%d@example.com", i)})
	}
	r := c.Post("/forgot-password", map[string]any{"email": "ann@example.com"}).Follow()
	if r.Page.Flash["success"] != "If that email has an account, a link to reset its password is on its way." {
		t.Errorf("the sixth ask: flash %v, want the answer every ask gets", r.Page.Flash)
	}
	app.outbox.None(t)
}

func TestJobsThatFailedOverAMonthAgoArePruned(t *testing.T) {
	s := &jobs{db: testDB(t)}
	ctx, now := context.Background(), time.Now()
	for _, days := range []int{40, 10} {
		s.Push(ctx, &queue.Job{Kind: "verify-mail", Payload: []byte(`{}`), RunAt: now})
		j, err := s.Claim(ctx, now, now.Add(time.Minute))
		if err != nil || j == nil {
			t.Fatalf("claimed %v, %v", j, err)
		}
		j.Error = fmt.Sprintf("failed %d days ago", days)
		s.Fail(ctx, j)
		failedDaysAgo(t, s.db, j.ID, days)
	}
	if err := s.prune(ctx, struct{}{}); err != nil {
		t.Fatal(err)
	}
	failed, err := s.Failed(ctx)
	if err != nil {
		t.Fatal(err)
	}
	if len(failed) != 1 || failed[0].Error != "failed 10 days ago" {
		t.Errorf("left %v, want the job that failed 10 days ago", failed)
	}
}

func TestTheAppPrunesFailedJobsEveryNight(t *testing.T) {
	started := time.Now().UTC()
	app := newTestApp(t)
	var runAt int64
	for deadline := time.Now().Add(5 * time.Second); ; {
		err := app.db.QueryRow("SELECT run_at FROM jobs WHERE kind = 'prune-jobs'").Scan(&runAt)
		if err == nil {
			break
		}
		if time.Now().After(deadline) {
			t.Fatalf("the prune job wasn't pushed: %v", err)
		}
		time.Sleep(10 * time.Millisecond)
	}
	// The next midnight UTC, or the one after, should one have come round
	// as the app started.
	midnight := started.Truncate(24 * time.Hour).Add(24 * time.Hour)
	if got := time.UnixMilli(runAt).UTC(); !got.Equal(midnight) && !got.Equal(midnight.Add(24*time.Hour)) {
		t.Errorf("the prune job runs at %v, want the next midnight UTC, %v", got, midnight)
	}
}
