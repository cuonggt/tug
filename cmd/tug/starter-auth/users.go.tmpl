package main

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
	"strconv"
	"time"

	"github.com/cuonggt/tug/auth"
)

// User is someone with an account. What only the server should know never
// leaves it: the json tags keep the password hash and the two-factor
// secret out of every page's props.
type User struct {
	ID              int64      `json:"id"`
	Name            string     `json:"name"`
	Email           string     `json:"email"`
	EmailVerifiedAt *time.Time `json:"emailVerifiedAt"` // null until they follow the link mailed to them
	TwoFactor       bool       `json:"twoFactor"`       // whether logging in takes a code from their phone too
	CreatedAt       time.Time  `json:"createdAt"`

	// Photo is a link to the user's photo, signed for a page to show it, or
	// null when they have none: see photos.go. PhotoKey is where the photo
	// is kept on the app's disk.
	Photo    *string `json:"photo"`
	PhotoKey string  `json:"-"`

	PasswordHash string `json:"-"`

	// The two-factor secret and recovery codes, sealed by auth.TwoFactor,
	// and the time step of the last code that worked. Empty, and 0, while
	// two-factor logins are off.
	TwoFactorSecret string `json:"-"`
	RecoveryCodes   string `json:"-"`
	TwoFactorStep   int64  `json:"-"`
}

// authID is the user's ID as package auth keeps it, in the session and in
// the links mailed to them.
func (u *User) authID() string {
	return strconv.FormatInt(u.ID, 10)
}

var (
	errNoUser     = errors.New("no such user")
	errEmailTaken = errors.New("the email has an account already")
)

// users are the app's users, in the database: the users table, whose
// queries are in users_db.go. An email is unique whatever its case:
// Ann@example.com is ann@example.com.
type users struct {
	db dbtx
}

// in is the users as tx reads and writes them, for a handler that writes
// in one transaction: see inTx.
func (us *users) in(tx *sql.Tx) *users {
	return &users{db: tx}
}

// dbtx is the database, or a transaction in it, which the tables' methods
// read and write through.
type dbtx interface {
	ExecContext(ctx context.Context, query string, args ...any) (sql.Result, error)
	QueryContext(ctx context.Context, query string, args ...any) (*sql.Rows, error)
	QueryRowContext(ctx context.Context, query string, args ...any) *sql.Row
}

// userColumns are a user's columns, in the order scanUser reads them.
const userColumns = "id, name, email, email_verified_at, password_hash, two_factor_secret, recovery_codes, two_factor_step, photo_key, created_at"

func scanUser(row *sql.Row) (*User, error) {
	u := &User{}
	var verified sql.NullTime
	var secret, codes, photo sql.NullString
	err := row.Scan(&u.ID, &u.Name, &u.Email, &verified, &u.PasswordHash, &secret, &codes, &u.TwoFactorStep, &photo, &u.CreatedAt)
	if errors.Is(err, sql.ErrNoRows) {
		return nil, errNoUser
	}
	if err != nil {
		return nil, err // no half-read user, whose login nothing has checked
	}
	if verified.Valid {
		u.EmailVerifiedAt = &verified.Time
	}
	u.TwoFactorSecret, u.RecoveryCodes, u.PhotoKey = secret.String, codes.String, photo.String
	u.TwoFactor = u.TwoFactorSecret != ""
	return u, nil
}

// sealedTwoFactor is a user's two-factor secret and recovery codes, as the
// users table keeps them, sealed.
type sealedTwoFactor struct {
	User          int64
	Secret, Codes string
}

// resealTwoFactor seals again, with tf's first key, the two-factor secrets
// and recovery codes sealed with another. After APP_KEY changes, with the
// old key in APP_PREVIOUS_KEYS, this moves every user's over at the first
// start, so the old key can go without taking anyone's second factor with
// it.
func (us *users) resealTwoFactor(ctx context.Context, tf *auth.TwoFactor) error {
	all, err := us.twoFactorSecrets(ctx)
	if err != nil {
		return err
	}
	for _, s := range all {
		if !tf.Stale(s.Secret) && (s.Codes == "" || !tf.Stale(s.Codes)) {
			continue
		}
		secret, err := tf.Open(s.Secret)
		if err != nil {
			return fmt.Errorf("user %d's two-factor secret: %w", s.User, err)
		}
		codes, err := tf.Open(s.Codes)
		if err != nil && s.Codes != "" {
			return fmt.Errorf("user %d's recovery codes: %w", s.User, err)
		}
		if err := us.swapTwoFactor(ctx, s, tf.Seal(secret), tf.Seal(codes)); err != nil {
			return err
		}
	}
	return nil
}

// nullIfEmpty stores "" as NULL.
func nullIfEmpty(s string) any {
	if s == "" {
		return nil
	}
	return s
}
