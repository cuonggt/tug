func TestTheBroadcastsKeepTheirPromises(t *testing.T) {
	broadcasttest.TestStore(t, func(t *testing.T) broadcast.Store {
		return &broadcasts{db: testDB(t)}
	})
}

// heard waits for an event on events that says name, and fails the test
// when none does in 10 seconds.
func heard(t *testing.T, events <-chan broadcast.Event, name string) broadcast.Event {
	t.Helper()
	deadline := time.After(10 * time.Second)
	for {
		select {
		case e, ok := <-events:
			if !ok {
				t.Fatalf("the subscription closed before %s came", name)
			}
			if e.Name == name {
				return e
			}
		case <-deadline:
			t.Fatalf("%s didn't come in 10 seconds", name)
		}
	}
}

// listening subscribes to channel on hub, and returns once the hub hears
// what's published on it, as it may not the moment it starts.
func listening(t *testing.T, hub *broadcast.Hub, channel string) <-chan broadcast.Event {
	t.Helper()
	events := hub.Subscribe(t.Context(), channel)
	for deadline := time.Now().Add(10 * time.Second); ; {
		if err := hub.Publish(t.Context(), channel, "ready", nil); err != nil {
			t.Fatal(err)
		}
		select {
		case e := <-events:
			if e.Name == "ready" {
				return events
			}
		case <-time.After(300 * time.Millisecond):
		}
		if time.Now().After(deadline) {
			t.Fatal("the hub heard nothing in 10 seconds")
		}
	}
}

func TestTheAppsInstancesHearEachOthersEvents(t *testing.T) {
	db := testDB(t)
	ctx, stop := context.WithCancel(context.Background())
	defer stop()
	one, other := &broadcast.Hub{Store: &broadcasts{db: db}}, &broadcast.Hub{Store: &broadcasts{db: db}}
	go one.Run(ctx)
	go other.Run(ctx)
	listening(t, one, "posts")
	events := listening(t, other, "posts")
	if err := one.Publish(ctx, "posts", "created", 26); err != nil {
		t.Fatal(err)
	}
	if e := heard(t, events, "created"); string(e.Data) != "26" {
		t.Errorf("the other instance heard %+v", e)
	}
}

func TestAnEventPublishedInATransactionThatRollsBackIsntHeard(t *testing.T) {
	db := testDB(t)
	ctx, stop := context.WithCancel(context.Background())
	defer stop()
	bs := &broadcasts{db: db}
	hub := &broadcast.Hub{Store: bs}
	go hub.Run(ctx)
	events := listening(t, hub, "posts")
	tx, err := db.BeginTx(ctx, nil)
	if err != nil {
		t.Fatal(err)
	}
	if err := hub.In(bs.in(tx)).Publish(ctx, "posts", "rolled-back", nil); err != nil {
		t.Fatal(err)
	}
	tx.Rollback()
	hub.Publish(ctx, "posts", "created", nil)
	if e := heard(t, events, "created"); e.Name != "created" {
		t.Errorf("heard %+v", e)
	}
	select {
	case e := <-events:
		t.Errorf("heard %+v after", e)
	case <-time.After(500 * time.Millisecond):
	}
}

