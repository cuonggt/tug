// streamed reads the names of the events of an event stream, as they
// come, until it ends.
func streamed(body io.Reader) <-chan string {
	names := make(chan string, 100)
	go func() {
		defer close(names)
		lines := bufio.NewScanner(body)
		for lines.Scan() {
			if name, ok := strings.CutPrefix(lines.Text(), "event: "); ok {
				names <- name
			}
		}
	}()
	return names
}

func TestAUsersPagesHearTheirOwnChannelAlone(t *testing.T) {
	app := newTestApp(t)
	c := app.client()
	cookie := register(c, "Ann", "ann@example.com", "correct horse").Cookie("tug_session")
	ann := user(c.Get("/verify-email"))
	if cookie == nil || ann == nil {
		t.Fatal("Ann isn't logged in")
	}
	// A stream stays open, as tugtest's client doesn't: a server, and Ann's
	// page on it.
	srv := httptest.NewServer(app)
	defer srv.Close()
	ctx, cancel := context.WithCancel(t.Context())
	defer cancel() // before srv.Close, which waits for the stream
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, srv.URL+"/broadcasts", nil)
	if err != nil {
		t.Fatal(err)
	}
	req.AddCookie(cookie)
	res, err := srv.Client().Do(req)
	if err != nil {
		t.Fatal(err)
	}
	defer res.Body.Close()
	if res.StatusCode != http.StatusOK || res.Header.Get("Content-Type") != "text/event-stream" {
		t.Fatalf("Ann's page got %s, %s", res.Status, res.Header.Get("Content-Type"))
	}
	names := streamed(res.Body)
	// The page is listening once it hears what's published, as the stream
	// opens before the hub hands it anything.
	heardReady := func() bool {
		if err := app.hub.Publish(ctx, userChannel(ann), "ready", nil); err != nil {
			t.Fatal(err)
		}
		select {
		case name, ok := <-names:
			if !ok {
				t.Fatal("Ann's stream ended")
			}
			return name == "ready"
		case <-time.After(300 * time.Millisecond):
			return false
		}
	}
	for deadline := time.Now().Add(10 * time.Second); !heardReady(); {
		if time.Now().After(deadline) {
			t.Fatal("Ann's page heard nothing in 10 seconds")
		}
	}

	bob := &User{ID: ann.ID + 1}
	app.hub.Publish(ctx, userChannel(bob), "verified", nil)
	app.hub.Publish(ctx, userChannel(ann), "created", nil)
	for name := range names {
		if name == "created" {
			return
		}
		if name != "ready" {
			t.Fatalf("Ann's page heard %s, on Bob's channel", name)
		}
	}
	t.Fatal("the stream ended before Ann's own event came")
}
