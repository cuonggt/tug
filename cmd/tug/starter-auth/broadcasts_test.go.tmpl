// An event published in a transaction goes as it commits, which may be
// after one published later has gone.
func TestAnEventThatCommitsAfterALaterOneIsHeardToo(t *testing.T) {
	db := testDB(t)
	ctx, stop := context.WithCancel(context.Background())
	defer stop()
	bs := &broadcasts{db: db}
	hub := &broadcast.Hub{Store: bs}
	go hub.Run(ctx)
	events := listening(t, hub, "posts")
	tx, err := db.BeginTx(ctx, nil)
	if err != nil {
		t.Fatal(err)
	}
	defer tx.Rollback()
	if err := hub.In(bs.in(tx)).Publish(ctx, "posts", "first", nil); err != nil {
		t.Fatal(err)
	}
	if err := hub.Publish(ctx, "posts", "second", nil); err != nil {
		t.Fatal(err)
	}
	heard(t, events, "second")
	if err := tx.Commit(); err != nil {
		t.Fatal(err)
	}
	heard(t, events, "first")
}
