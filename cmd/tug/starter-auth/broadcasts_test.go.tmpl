func TestTheAppPrunesTheEventsItCarried(t *testing.T) {
	bs := &broadcasts{db: testDB(t)}
	ctx := context.Background()
	event := []byte(`{"channel":"posts","name":"created","data":null}`)
	if _, err := bs.db.Exec("INSERT INTO broadcasts (event, created_at) VALUES (?, ?)", event, time.Now().Add(-time.Hour).UnixMilli()); err != nil {
		t.Fatal(err)
	}
	if err := bs.Publish(ctx, event); err != nil {
		t.Fatal(err)
	}
	if err := bs.prune(ctx, struct{}{}); err != nil {
		t.Fatal(err)
	}
	var n int
	bs.db.QueryRow("SELECT count(*) FROM broadcasts").Scan(&n)
	if n != 1 {
		t.Errorf("%d events left, want the one not a minute old", n)
	}
}
