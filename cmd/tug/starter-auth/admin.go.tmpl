// What admins have: a page of the users, who are found by email or name,
// suspended and restored, and acted as, to see the app as one does, to
// help them; a page of the jobs that failed for good, which runs them
// again, as the jobs command does, for someone who may see every user's
// jobs; and the admins command, which makes someone an admin. Who may is
// in abilities.go.

var (
	Users      = tug.Page[UsersProps]("Admin/Users")
	FailedJobs = tug.Page[FailedJobsProps]("Admin/FailedJobs")
)

// usersPerPage is how many users a page of them has.
const usersPerPage = 20

// UsersProps are the users, the newest first, a page at a time: those
// whose email or name has Search in it, or all of them.
type UsersProps struct {
	List   tug.SimplePaginated[ListedUser] `json:"list"`
	Search string                          `json:"search"`
}

// ListedUser is a user as the users page lists them: whether their email
// is verified, their two-factor logins are on, they're an admin, or
// suspended, when they joined, and what the admin may do with them.
type ListedUser struct {
	ID          int64      `json:"id"`
	Name        string     `json:"name"`
	Email       string     `json:"email"`
	Verified    bool       `json:"verified"`
	TwoFactor   bool       `json:"twoFactor"`
	Admin       bool       `json:"admin"`
	SuspendedAt *time.Time `json:"suspendedAt"` // null for an account that isn't
	CreatedAt   time.Time  `json:"createdAt"`
	Can         UserCan    `json:"can"`
}

// UserCan is what the admin may do with a listed user, for its buttons.
// Any admin may restore a suspended one.
type UserCan struct {
	Suspend bool `json:"suspend"`
	ActAs   bool `json:"actAs"`
}

// usersPage lists the users, the newest first, found by their email or
// name, in any case, with ?search=: a lower-cased LIKE, as each database
// has it, rather than search of the full text, which an app of many users
// adds.
func (a *app) usersPage(c *tug.Ctx, admin *User) error {
	search := strings.TrimSpace(c.Query("search"))
	list, err := tug.SimplePaginate(c, usersPerPage, func(limit, offset int) ([]ListedUser, error) {
		found, err := a.users.page(c.Context(), search, limit, offset)
		if err != nil {
			return nil, err
		}
		listed := make([]ListedUser, 0, len(found))
		for _, u := range found {
			listed = append(listed, ListedUser{
				ID: u.ID, Name: u.Name, Email: u.Email, Verified: u.EmailVerifiedAt != nil, TwoFactor: u.TwoFactor,
				Admin: u.Admin, SuspendedAt: u.SuspendedAt, CreatedAt: u.CreatedAt,
				Can: UserCan{Suspend: may(c.Context(), suspendUser, admin, u), ActAs: may(c.Context(), actAsUser, admin, u)},
			})
		}
		return listed, nil
	})
	if err != nil {
		return err
	}
	return Users.Render(c, UsersProps{List: list, Search: search})
}

// userOfPath is the user the path's {id} names, or a 404.
func (a *app) userOfPath(c *tug.Ctx) (*User, error) {
	id, err := strconv.ParseInt(c.Param("id"), 10, 64)
	if err != nil {
		return nil, tug.NewHTTPError(http.StatusNotFound, "user not found")
	}
	u, err := a.users.byID(c.Context(), id)
	if errors.Is(err, errNoUser) {
		return nil, tug.NewHTTPError(http.StatusNotFound, "user not found")
	}
	return u, err
}

// suspend suspends a user, as an account that abuses the app, rather than
// deleting it, which stays its owner's: its logins end at their next
// request, its API tokens are turned away, and it can't log in again,
// told why, until an admin restores it. Its owner hears of it, by mail and
// as a notification.
func (a *app) suspend(c *tug.Ctx, admin *User) error {
	them, err := a.userOfPath(c)
	if err != nil {
		return err
	}
	if err := suspendUser.Check(c.Context(), admin, them); err != nil {
		return err
	}
	done, err := a.setSuspended(c.Context(), them, true)
	if err != nil {
		return err
	}
	if !done {
		c.Flash("error", them.Name+" is suspended already.")
		return c.RedirectBack()
	}
	slog.InfoContext(c.Context(), "an admin suspended a user", "admin", admin.ID, "user", them.ID)
	c.Flash("success", them.Name+" is suspended, and has been told by mail.")
	return c.RedirectBack()
}

// restore lets a suspended user back in, and tells them, as suspending
// did.
func (a *app) restore(c *tug.Ctx, admin *User) error {
	them, err := a.userOfPath(c)
	if err != nil {
		return err
	}
	done, err := a.setSuspended(c.Context(), them, false)
	if err != nil {
		return err
	}
	if !done {
		c.Flash("error", them.Name+" isn't suspended.")
		return c.RedirectBack()
	}
	slog.InfoContext(c.Context(), "an admin restored a user", "admin", admin.ID, "user", them.ID)
	c.Flash("success", them.Name+" is restored, and has been told by mail.")
	return c.RedirectBack()
}

// setSuspended suspends them, or restores them, and notifies them, in one
// transaction, and reports whether it changed them: of two admins at
// once, one does, and one notification goes.
func (a *app) setSuspended(ctx context.Context, them *User, suspended bool) (bool, error) {
	kind := "account-restored"
	if suspended {
		kind = "account-suspended"
	}
	var done bool
	err := a.inTx(ctx, func(tx *sql.Tx) error {
		var err error
		if done, err = a.users.in(tx).setSuspended(ctx, them.ID, suspended); err != nil || !done {
			return err
		}
		return a.notify(ctx, tx, them.ID, kind, noticeData{})
	})
	return done, err
}

// actingFor is how long an admin acts as a user at most.
const actingFor = time.Hour

// actAs has the admin act as a user, to see the app as they do, and help
// them: the session is logged in as the user, with the admin's own login
// kept beside it, which the line at the top of each page goes back to,
// stopActing, in auth.go. Meanwhile, what could hand the account to
// someone else is refused, ownersOnly, and what asks for the password
// again asks for the user's. The log says who acted as whom; the user
// isn't told, as helping them is the point.
func (a *app) actAs(c *tug.Ctx, admin *User) error {
	them, err := a.userOfPath(c)
	if err != nil {
		return err
	}
	if err := actAsUser.Check(c.Context(), admin, them); err != nil {
		return err
	}
	s := c.Session()
	s.Delete(setupKey) // the admin's own two-factor setup, under way, isn't the user's
	auth.ActAs(s, them.authID(), them.PasswordHash, actingFor)
	slog.InfoContext(c.Context(), "an admin started acting as a user", "admin", admin.ID, "user", them.ID)
	return c.RedirectRoute("dashboard")
}

// FailedJobsProps are the jobs that failed for good, the latest first.
type FailedJobsProps struct {
	Jobs []FailedJob `json:"jobs"`
}

// FailedJob is a job that failed for good, as its page shows it.
type FailedJob struct {
	ID       string    `json:"id"`
	Kind     string    `json:"kind"`
	Payload  string    `json:"payload"` // the value it was pushed with, as JSON
	Attempts int       `json:"attempts"`
	Error    string    `json:"error"`
	FailedAt time.Time `json:"failedAt"`
}

// failedJobsPage lists the jobs that failed for good, which are kept for
// a month, the latest first.
func (a *app) failedJobsPage(c *tug.Ctx, _ *User) error {
	failed, err := a.jobs.Failed(c.Context())
	if err != nil {
		return err
	}
	jobs := make([]FailedJob, len(failed))
	for i, j := range failed {
		jobs[i] = FailedJob{ID: j.ID, Kind: j.Kind, Payload: string(j.Payload), Attempts: j.Attempts, Error: j.Error, FailedAt: j.FailedAt}
	}
	return FailedJobs.Render(c, FailedJobsProps{Jobs: jobs})
}

// retryFailedJob puts a job that failed for good back to run, from its
// first attempt, and wakes the queue. One that another admin has run
// again already says so.
func (a *app) retryFailedJob(c *tug.Ctx, _ *User) error {
	id := c.Param("id")
	again, err := a.jobs.RunAgain(c.Context(), id, time.Now())
	if err != nil {
		return err
	}
	if !again {
		c.Flash("error", "Job "+id+" hasn't failed for good, or has gone: it's been run again already, maybe.")
		return c.RedirectRoute("failed-jobs.index")
	}
	a.queue.Wake()
	c.Flash("success", "Job "+id+" is back to run.")
	return c.RedirectRoute("failed-jobs.index")
}

// retryFailedJobs puts every job that failed for good back to run.
func (a *app) retryFailedJobs(c *tug.Ctx, _ *User) error {
	failed, err := a.jobs.Failed(c.Context())
	if err != nil {
		return err
	}
	n := 0
	for _, j := range failed {
		again, err := a.jobs.RunAgain(c.Context(), j.ID, time.Now())
		if err != nil {
			return err
		}
		if again {
			n++
		}
	}
	a.queue.Wake()
	c.Flash("success", fmt.Sprintf("%s back to run.", howMany(n, "job")))
	return c.RedirectRoute("failed-jobs.index")
}

// adminsCommand is the admins command, name admins, which lists the
// admins, and name admins add ann@example.com, or remove, which makes
// someone an admin, or a user again: the app's own binary, run where it
// runs, with the database it's given, as there's no admin to ask before
// the first.
func adminsCommand(ctx context.Context, us *users, name string, args []string, w io.Writer) error {
	switch {
	case len(args) == 0:
		admins, err := us.admins(ctx)
		if err != nil {
			return err
		}
		if len(admins) == 0 {
			fmt.Fprintf(w, "No one is an admin: %s admins add <email> makes someone one.\n", name)
			return nil
		}
		fmt.Fprintf(w, "%s:\n\n", howMany(len(admins), "admin"))
		for _, u := range admins {
			fmt.Fprintf(w, "  %s  %s\n", u.Email, u.Name)
		}
		fmt.Fprintf(w, "\n%s admins add <email> makes someone an admin, and %s admins remove <email> a user again.\n", name, name)
		return nil

	case len(args) == 2 && (args[0] == "add" || args[0] == "remove"):
		u, err := us.byEmail(ctx, args[1])
		if errors.Is(err, errNoUser) {
			return fmt.Errorf("no account has the email %s", args[1])
		}
		if err != nil {
			return err
		}
		admin := args[0] == "add"
		if err := us.setAdmin(ctx, u.ID, admin); err != nil {
			return err
		}
		if admin {
			fmt.Fprintf(w, "%s is an admin.\n", u.Email)
		} else {
			fmt.Fprintf(w, "%s is a user again, and not an admin.\n", u.Email)
		}
		return nil
	}
	return fmt.Errorf("%s admins lists the admins, and %s admins add <email>, or remove <email>, makes someone an admin or a user again", name, name)
}
