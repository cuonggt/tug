# Copy to .env, which tug dev reads. APP_KEY encrypts the sessions and the
# two-factor secrets, and signs the links in the app's mail: make one with
# `head -c 32 /dev/urandom | base64`, and write it as base64:<that>. To
# change it, move the old one to APP_PREVIOUS_KEYS, comma separated, for a
# month, as long as a remembered login lasts: sessions and links made with
# it still work meanwhile, and the app seals the two-factor secrets again
# with the new one as it starts.
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true

# The app's own address, which the links in its mail start with, such as
# https://example.com. Only in development, with APP_DEBUG on, can it be
# left out. With https://, the session cookie is for HTTPS only.
APP_URL=

[[ if .SQLite -]]
# Where the SQLite database is. Default app.db.
DB_PATH=app.db
[[- else -]]
# The [[ if .MySQL ]]MySQL[[ else ]]Postgres[[ end ]] database, which compose.yaml runs in development:
# `docker compose up -d`. A deployed app's is DB_URL, such as
[[- if .MySQL ]]
# mysql://user:password@host:3306/[[ .DBName ]]?tls=true, with the driver's
[[- else ]]
# postgres://user:password@host:5432/[[ .DBName ]]?sslmode=require, with the driver's
[[- end ]]
# settings in its query, or DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME and
# DB_PASSWORD, as Laravel has them.
DB_URL=[[ .DevURL ]]
[[- end ]]

# Where the files people upload, their photos, are kept: a directory,
# files unless FILES_PATH says, served by links signed with APP_KEY. With
# FILESYSTEM_DISK=s3, they're in AWS_BUCKET, in S3 or a service that
# speaks its API: AWS_ENDPOINT for one that isn't AWS, as Cloudflare R2's
# https://<account>.r2.cloudflarestorage.com, and
# AWS_USE_PATH_STYLE_ENDPOINT=true for MinIO.
FILESYSTEM_DISK=local
FILES_PATH=files
AWS_BUCKET=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# How many background jobs, such as mail, the app runs at once. With 0 it
# runs none, and leaves its jobs to another instance on the same database.
QUEUE_WORKERS=4
[[- if .SSR ]]

# Pages render on the server with Node, which the app runs beside it: the
# node on PATH, or the one SSR_NODE names. SSR_URL names an SSR server run
# apart instead, such as http://127.0.0.1:13714, and the app runs none.
SSR_NODE=
SSR_URL=
[[- end ]]

# The SMTP server that sends the app's mail. Without MAIL_HOST, mail is
# written out where tug dev shows it instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
