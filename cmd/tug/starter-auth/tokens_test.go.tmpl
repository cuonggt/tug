func TestTheSitesCORSOriginsNamesCallTheAPI(t *testing.T) {
	t.Setenv("CORS_ORIGINS", "https://app.example.com")
	app := newTestApp(t)
	token := makeToken(t, app.verifiedUser("Ann", "ann@example.com", "correct horse"), "My script", []string{"user:read"}, "0")
	r := app.api("OPTIONS", "/api/user", "", "Origin", "https://app.example.com", "Access-Control-Request-Method", "GET", "Access-Control-Request-Headers", "authorization")
	if r.Code != http.StatusNoContent || r.Header.Get("Access-Control-Allow-Origin") != "https://app.example.com" || r.Header.Get("Access-Control-Allow-Headers") != "authorization" {
		t.Errorf("a preflight from a site named: %d, %v", r.Code, r.Header)
	}
	if r := app.api("GET", "/api/user", token, "Origin", "https://app.example.com"); r.Code != http.StatusOK || r.Header.Get("Access-Control-Allow-Origin") != "https://app.example.com" {
		t.Errorf("a call from a site named: %d, %v", r.Code, r.Header)
	}
	if r := app.api("GET", "/api/user", token, "Origin", "https://evil.example"); r.Header.Get("Access-Control-Allow-Origin") != "" {
		t.Errorf("a call from another site: %v", r.Header)
	}
}
