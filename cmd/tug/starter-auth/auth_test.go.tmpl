func TestTheSettingsAskForThePasswordOnAnOldLogin(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	c := app.oldLogin("ann@example.com")
	for _, page := range []string{"/settings/profile", "/settings/security"} {
		if r := c.Get(page); r.Location() != "/confirm-password" {
			t.Errorf("%v, want to confirm the password", r)
		}
	}
	if r := c.Get("/confirm-password"); r.Page.Component != "Auth/ConfirmPassword" {
		t.Fatalf("the page that asks: %v", r)
	}
	if errs := c.Post("/confirm-password", map[string]any{"password": "wrong horse"}).Follow().Errors(); errs["password"] != "that isn't your password" {
		t.Errorf("errors %v", errs)
	}
	if r := c.Post("/confirm-password", map[string]any{"password": "correct horse"}); r.Location() != "/settings/security" {
		t.Fatalf("confirming: %v, want back to the page it was on its way to", r)
	}
	if r := c.Get("/settings/profile"); r.Page.Component != "Settings/Profile" {
		t.Errorf("the profile, confirmed: %v", r)
	}
}

func TestAFormSentAfterTheConfirmationRanOutGoesBackToItsPage(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	c := app.oldLogin("ann@example.com")
	// The profile was open from before the confirmation ran out.
	r := c.Patch("/settings/profile", map[string]any{"name": "Mallory", "email": "ann@example.com"},
		tugtest.Header("Referer", "http://example.com/settings/profile"))
	if r.Location() != "/confirm-password" {
		t.Fatalf("saving the profile: %v", r)
	}
	if r := c.Post("/confirm-password", map[string]any{"password": "correct horse"}); r.Location() != "/settings/profile" {
		t.Errorf("confirming: %v", r)
	}
	if u := tugtest.Props(c.Get("/settings/profile"), Profile).User; u.Name != "Ann" {
		t.Errorf("the form went through unconfirmed: name %q", u.Name)
	}
}
