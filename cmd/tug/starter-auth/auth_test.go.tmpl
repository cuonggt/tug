func TestRegisteringLogsInAndAsksForTheEmailToBeVerified(t *testing.T) {
	app := newTestApp(t)
	c := app.client()
	if r := register(c, "Ann", "ann@example.com", "correct horse"); r.Code != http.StatusSeeOther || r.Location() != "/dashboard" {
		t.Fatalf("registering: %v", r)
	}
	if r := c.Get("/dashboard"); r.Location() != "/verify-email" {
		t.Fatalf("the dashboard before the email is verified: %v", r)
	}
	r := c.Get("/verify-email")
	if u := user(r); r.Page.Component != "Auth/VerifyEmail" || r.Page.Flash["success"] != "Welcome, Ann!" || u == nil || u.EmailVerifiedAt != nil {
		t.Fatalf("the page after registering: %v, flash %v, user %+v", r, r.Page.Flash, u)
	}

	m := app.mail()
	if m.To[0] != "ann@example.com" || !strings.Contains(m.HTML, "Verify my email") {
		t.Errorf("the mail to %v:\n%s", m.To, m.HTML)
	}
	if r := c.Get(link(t, m, "/verify-email/")); r.Location() != "/dashboard" {
		t.Fatalf("following the link: %v", r)
	}
	r = c.Get("/dashboard")
	if u := tugtest.Props(r, Dashboard).User; u.EmailVerifiedAt == nil {
		t.Fatalf("the dashboard once verified: %+v", u)
	}
	if r.Page.Flash["success"] != "Thanks: your email is verified." {
		t.Errorf("flash %v", r.Page.Flash)
	}
}

func TestAVerificationLinkWorksInABrowserThatIsntLoggedIn(t *testing.T) {
	app := newTestApp(t)
	register(app.client(), "Ann", "ann@example.com", "correct horse")
	phone := app.client()
	if r := phone.Get(link(t, app.mail(), "/verify-email/")); r.Location() != "/dashboard" {
		t.Fatalf("following the link: %v", r)
	}
	// Sent to log in, where the news is waiting.
	if r := phone.Get("/dashboard"); r.Location() != "/login" {
		t.Fatalf("the dashboard: %v", r)
	}
	if r := phone.Get("/login"); r.Page.Flash["success"] != "Thanks: your email is verified." {
		t.Errorf("flash %v", r.Page.Flash)
	}
	logIn(phone, "ann@example.com", "correct horse")
	if r := phone.Get("/dashboard"); r.Page.Component != "Dashboard" {
		t.Errorf("verified, the dashboard is still %v", r)
	}
}

func TestAVerificationLinkForAnOldEmailOrTamperedWithVerifiesNothing(t *testing.T) {
	app := newTestApp(t)
	c := app.client()
	register(c, "Ann", "ann@example.com", "correct horse")
	old := link(t, app.mail(), "/verify-email/")
	c.Patch("/settings/profile", map[string]any{"name": "Ann", "email": "ann@elsewhere.example"})
	app.mail() // the link for the new email

	for _, bad := range []string{old, old + "x", strings.Replace(old, "/verify-email/1/", "/verify-email/2/", 1)} {
		if r := c.Get(bad); r.Location() != "/verify-email" {
			t.Errorf("%s: %v", bad, r)
		}
		r := c.Get("/verify-email")
		if msg, _ := r.Page.Flash["error"].(string); !strings.HasPrefix(msg, "That link has expired") {
			t.Errorf("%s: flash %v", bad, r.Page.Flash)
		}
		if u := user(r); u == nil || u.EmailVerifiedAt != nil {
			t.Errorf("%s: user %+v", bad, u)
		}
	}
}

func TestAnotherLinkCanBeSentOnceAMinute(t *testing.T) {
	app := newTestApp(t)
	c := app.client()
	register(c, "Ann", "ann@example.com", "correct horse")
	app.mail()
	c.Get("/settings/profile")
	if r := c.Post("/verify-email", nil); r.Location() != "/settings/profile" {
		t.Fatalf("sending another: %v, want back where it was asked for", r)
	}
	if r := c.Get("/settings/profile"); r.Page.Flash["success"] != "A new link is on its way to ann@example.com." {
		t.Errorf("flash %v", r.Page.Flash)
	}
	link(t, app.mail(), "/verify-email/")

	c.Post("/verify-email", nil)
	if msg, _ := c.Get("/settings/profile").Page.Flash["error"].(string); !strings.HasPrefix(msg, "A link went a moment ago") {
		t.Errorf("a second in the minute: flash %q", msg)
	}
	app.noMail()
}

func TestAnEmailHasOneAccount(t *testing.T) {
	app := newTestApp(t)
	register(app.client(), "Ann", "ann@example.com", "correct horse")
	c := app.client()
	c.Get("/register")
	r := register(c, "Imposter", "ANN@example.com", "correct horse")
	if r.Location() != "/register" {
		t.Fatalf("registering again: %v, want back to the form", r)
	}
	if r = r.Follow(); r.Errors()["email"] != "email has an account already: log in to it" || user(r) != nil {
		t.Errorf("errors %v, user %+v", r.Errors(), user(r))
	}
}

func TestRegisteringTakesThePasswordTypedTwice(t *testing.T) {
	app := newTestApp(t)
	c := app.client()
	c.Get("/register")
	r := c.Post("/register", map[string]any{"name": "Ann", "email": "ann@example.com", "password": "correct horse", "password_confirmation": "correct hose"})
	if errs := r.Follow().Errors(); errs["password_confirmation"] != "the passwords don't match" {
		t.Errorf("errors %v", errs)
	}
	if errs := register(c, "Ann", "ann@example.com", "short").Follow().Errors(); errs["password"] != "password must be at least 8 characters" {
		t.Errorf("errors %v", errs)
	}
}

func TestAGuestIsSentToLogInAndBackAfter(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	c := app.client()
	if r := c.Get("/settings/appearance?from=menu"); r.Code != http.StatusFound || r.Location() != "/login" {
		t.Fatalf("a guest's settings: %v", r)
	}
	if r := logIn(c, "ann@example.com", "correct horse"); r.Code != http.StatusSeeOther || r.Location() != "/settings/appearance?from=menu" {
		t.Fatalf("logging in: %v", r)
	}
	if u := user(c.Get("/")); u == nil || u.Name != "Ann" {
		t.Errorf("auth.user %+v", u)
	}
}

func TestAWrongPasswordDoesntLogIn(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	for _, email := range []string{"ann@example.com", "bob@example.com"} {
		c := app.client()
		c.Get("/login")
		if errs := logIn(c, email, "wrong horse").Follow().Errors(); errs["email"] != "the email and password don't match an account" {
			t.Errorf("%s: errors %v", email, errs)
		}
		if r := c.Get("/dashboard"); r.Location() != "/login" {
			t.Errorf("%s: logged in with the wrong password", email)
		}
	}
}

func TestTooManyWrongPasswordsWaitAMinute(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	c := app.client()
	for range 5 {
		logIn(c, "ann@example.com", "wrong horse")
	}
	logIn(c, "ann@example.com", "correct horse")
	r := c.Get("/login")
	if msg := r.Errors()["email"]; !strings.HasPrefix(msg, "too many tries: wait ") || user(r) != nil {
		t.Errorf("errors %v, user %+v", r.Errors(), user(r))
	}
}

func TestRememberMeKeepsTheLoginForAMonth(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	// As the login form sends the box: "on" when it's ticked, and nothing
	// when it isn't.
	for remember, maxAge := range map[string]int{"on": 30 * 24 * 60 * 60, "": 2 * 60 * 60} {
		c := app.client()
		body := map[string]any{"email": "ann@example.com", "password": "correct horse"}
		if remember != "" {
			body["remember"] = remember
		}
		r := c.Post("/login", body)
		if ck := r.Cookie("tug_session"); r.Location() != "/dashboard" || ck == nil || ck.MaxAge != maxAge {
			t.Errorf("remember %q: %v, cookie %v", remember, r, ck)
		}
		// And on the visits after, which start its time again.
		if ck := c.Get("/dashboard").Cookie("tug_session"); ck == nil || ck.MaxAge != maxAge {
			t.Errorf("remember %q, the next visit: cookie %v", remember, ck)
		}
	}
}

func TestLoggingOutEndsTheLogin(t *testing.T) {
	app := newTestApp(t)
	c := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	r := c.Post("/logout", nil)
	if r.Location() != "/" {
		t.Fatalf("logging out: %v", r)
	}
	r = r.Follow()
	if user(r) != nil || r.Page.Flash["success"] != "You've logged out." {
		t.Errorf("auth.user %+v, flash %v", user(r), r.Page.Flash)
	}
	if !r.Page.EncryptHistory || !r.Page.ClearHistory {
		t.Error("the history the browser keeps isn't cleared: Back could show the dashboard")
	}
	if r := c.Get("/dashboard"); r.Location() != "/login" {
		t.Errorf("the dashboard after logging out: %v", r)
	}
}

