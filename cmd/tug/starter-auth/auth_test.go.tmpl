func TestAGuestIsSentToLogInAndBackAfter(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	v := app.visitor()
	if r := v.get("/settings/appearance?from=menu"); r.code != http.StatusFound || r.location != "/login" {
		t.Fatalf("a guest's settings: %d to %q", r.code, r.location)
	}
	if r := logIn(v, "ann@example.com", "correct horse"); r.code != http.StatusSeeOther || r.location != "/settings/appearance?from=menu" {
		t.Fatalf("logging in: %d to %q", r.code, r.location)
	}
	if r := v.get("/"); r.user()["name"] != "Ann" {
		t.Errorf("auth.user %v", r.user())
	}
}

func TestAWrongPasswordDoesntLogIn(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	for _, email := range []string{"ann@example.com", "bob@example.com"} {
		v := app.visitor()
		logIn(v, email, "wrong horse")
		if r := v.get("/login"); r.errors()["email"] != "the email and password don't match an account" {
			t.Errorf("%s: errors %v", email, r.errors())
		}
		if r := v.get("/dashboard"); r.location != "/login" {
			t.Errorf("%s: logged in with the wrong password", email)
		}
	}
}

func TestTooManyWrongPasswordsWaitAMinute(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	v := app.visitor()
	for range 5 {
		logIn(v, "ann@example.com", "wrong horse")
	}
	logIn(v, "ann@example.com", "correct horse")
	r := v.get("/login")
	if msg, _ := r.errors()["email"].(string); !strings.HasPrefix(msg, "too many tries: wait ") || r.user() != nil {
		t.Errorf("errors %v, user %v", r.errors(), r.user())
	}
}

func TestRememberMeKeepsTheLoginForAMonth(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	for remember, maxAge := range map[bool]int{true: 30 * 24 * 60 * 60, false: 2 * 60 * 60} {
		v := app.visitor()
		r := v.visit("POST", "/login", map[string]any{"email": "ann@example.com", "password": "correct horse", "remember": remember})
		if r.location != "/dashboard" || r.cookie == nil || r.cookie.MaxAge != maxAge {
			t.Errorf("remember %v: %d to %q, cookie %v", remember, r.code, r.location, r.cookie)
		}
		// And on the visits after, which start its time again.
		if r := v.get("/dashboard"); r.cookie == nil || r.cookie.MaxAge != maxAge {
			t.Errorf("remember %v, the next visit: cookie %v", remember, r.cookie)
		}
	}
}

func TestLoggingOutEndsTheLogin(t *testing.T) {
	app := newTestApp(t)
	v := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	if r := v.visit("POST", "/logout", nil); r.location != "/" {
		t.Fatalf("logging out: %d to %q", r.code, r.location)
	}
	r := v.get("/")
	if r.user() != nil || r.page.Flash["success"] != "You've logged out." {
		t.Errorf("auth.user %v, flash %v", r.user(), r.page.Flash)
	}
	if !r.page.EncryptHistory || !r.page.ClearHistory {
		t.Error("the history the browser keeps isn't cleared: Back could show the dashboard")
	}
	if r := v.get("/dashboard"); r.location != "/login" {
		t.Errorf("the dashboard after logging out: %d to %q", r.code, r.location)
	}
}

