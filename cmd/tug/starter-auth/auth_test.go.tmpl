// resetLink asks for a reset link for email, and returns its path.
func resetLink(t *testing.T, app *testApp, email string) string {
	t.Helper()
	if r := app.client().Post("/forgot-password", map[string]any{"email": email}); r.Location() != "/forgot-password" {
		t.Fatalf("asking for a link: %v", r)
	}
	m := app.mail()
	if m.To[0] != email || !strings.HasPrefix(m.Subject, "Reset your") {
		t.Fatalf("mail to %v: %s", m.To, m.Subject)
	}
	return link(t, m, "/reset-password/")
}

// resetPassword follows a reset link in c, and sets password with it.
func resetPassword(t *testing.T, c *tugtest.Client, link, password string) *tugtest.Response {
	t.Helper()
	page := tugtest.Props(c.Get(link), ResetPassword)
	if page.Token == "" {
		t.Fatalf("the reset page has no token: %+v", page)
	}
	return c.Post("/reset-password", map[string]any{
		"token": page.Token, "email": page.Email, "password": password, "password_confirmation": password,
	})
}

func TestAResetLinkSetsANewPasswordOnce(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	c := app.client()
	l := resetLink(t, app, "ann@example.com")
	if r := resetPassword(t, c, l, "battery staple"); r.Location() != "/dashboard" {
		t.Fatalf("resetting: %v", r)
	}
	if r := c.Get("/dashboard"); r.Page.Flash["success"] != "Your password is reset." {
		t.Errorf("flash %v", r.Page.Flash)
	}
	if r := logIn(app.client(), "ann@example.com", "battery staple"); r.Location() != "/dashboard" {
		t.Errorf("the new password doesn't log in: %v", r)
	}
	again := app.client()
	if errs := resetPassword(t, again, l, "stolen horse").Follow().Errors(); errs["email"] != "this link has expired, or been used" {
		t.Errorf("the link worked twice: errors %v", errs)
	}
}

func TestResettingAPasswordLogsOutTheOtherSessions(t *testing.T) {
	app := newTestApp(t)
	laptop := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	resetPassword(t, app.client(), resetLink(t, app, "ann@example.com"), "battery staple")
	if r := laptop.Get("/dashboard"); r.Location() != "/login" {
		t.Errorf("the old login still works: %v", r)
	}
}

func TestResettingAPasswordVerifiesTheEmailItWasSentTo(t *testing.T) {
