func TestTheSettingsAskForThePasswordOnAnOldLogin(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	v := app.oldLogin("ann@example.com")
	for _, page := range []string{"/settings/profile", "/settings/security"} {
		if r := v.get(page); r.location != "/confirm-password" {
			t.Errorf("%s: %d to %q", page, r.code, r.location)
		}
	}
	if r := v.get("/confirm-password"); r.page.Component != "Auth/ConfirmPassword" {
		t.Fatalf("the page that asks: %d %+v", r.code, r.page)
	}
	v.visit("POST", "/confirm-password", map[string]any{"password": "wrong horse"})
	if r := v.get("/confirm-password"); r.errors()["password"] != "that isn't your password" {
		t.Errorf("errors %v", r.errors())
	}
	if r := v.visit("POST", "/confirm-password", map[string]any{"password": "correct horse"}); r.location != "/settings/security" {
		t.Fatalf("confirming: %d to %q, want back to the page it was on its way to", r.code, r.location)
	}
	if r := v.get("/settings/profile"); r.page.Component != "Settings/Profile" {
		t.Errorf("the profile, confirmed: %d to %q", r.code, r.location)
	}
}

func TestAFormSentAfterTheConfirmationRanOutGoesBackToItsPage(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	v := app.oldLogin("ann@example.com")
	r := v.visit("PATCH", "/settings/profile", map[string]any{"name": "Mallory", "email": "ann@example.com"},
		"Referer", "http://example.com/settings/profile")
	if r.location != "/confirm-password" {
		t.Fatalf("saving the profile: %d to %q", r.code, r.location)
	}
	if r := v.visit("POST", "/confirm-password", map[string]any{"password": "correct horse"}); r.location != "/settings/profile" {
		t.Errorf("confirming: %d to %q", r.code, r.location)
	}
	if r := v.get("/settings/profile"); r.user()["name"] != "Ann" {
		t.Errorf("the form went through unconfirmed: name %v", r.user()["name"])
	}
}
