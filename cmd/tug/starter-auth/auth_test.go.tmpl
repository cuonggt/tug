func TestRegisteringLogsInAndAsksForTheEmailToBeVerified(t *testing.T) {
	app := newTestApp(t)
	v := app.visitor()
	if r := register(v, "Ann", "ann@example.com", "correct horse"); r.code != http.StatusSeeOther || r.location != "/dashboard" {
		t.Fatalf("registering: %d to %q", r.code, r.location)
	}
	if r := v.get("/dashboard"); r.location != "/verify-email" {
		t.Fatalf("the dashboard before the email is verified: %d to %q", r.code, r.location)
	}
	r := v.get("/verify-email")
	if r.page.Component != "Auth/VerifyEmail" || r.page.Flash["success"] != "Welcome, Ann!" || r.user()["emailVerifiedAt"] != nil {
		t.Fatalf("the page after registering: %+v", r.page)
	}

	m := app.mail()
	if m.To[0] != "ann@example.com" || !strings.Contains(m.HTML, "Verify my email") {
		t.Errorf("the mail to %v:\n%s", m.To, m.HTML)
	}
	if r := v.get(link(t, m, "/verify-email/")); r.location != "/dashboard" {
		t.Fatalf("following the link: %d to %q", r.code, r.location)
	}
	r = v.get("/dashboard")
	if user, _ := r.page.Props["user"].(map[string]any); r.page.Component != "Dashboard" || user["emailVerifiedAt"] == nil {
		t.Fatalf("the dashboard once verified: %d %+v", r.code, r.page)
	}
	if r.page.Flash["success"] != "Thanks: your email is verified." {
		t.Errorf("flash %v", r.page.Flash)
	}
}

func TestAVerificationLinkWorksInABrowserThatIsntLoggedIn(t *testing.T) {
	app := newTestApp(t)
	register(app.visitor(), "Ann", "ann@example.com", "correct horse")
	phone := app.visitor()
	if r := phone.get(link(t, app.mail(), "/verify-email/")); r.location != "/dashboard" {
		t.Fatalf("following the link: %d to %q", r.code, r.location)
	}
	// Sent to log in, where the news is waiting.
	if r := phone.get("/dashboard"); r.location != "/login" {
		t.Fatalf("the dashboard: %d to %q", r.code, r.location)
	}
	if r := phone.get("/login"); r.page.Flash["success"] != "Thanks: your email is verified." {
		t.Errorf("flash %v", r.page.Flash)
	}
	logIn(phone, "ann@example.com", "correct horse")
	if r := phone.get("/dashboard"); r.page.Component != "Dashboard" {
		t.Errorf("verified, the dashboard is still %d to %q", r.code, r.location)
	}
}

func TestAVerificationLinkForAnOldEmailOrTamperedWithVerifiesNothing(t *testing.T) {
	app := newTestApp(t)
	v := app.visitor()
	register(v, "Ann", "ann@example.com", "correct horse")
	old := link(t, app.mail(), "/verify-email/")
	v.visit("PATCH", "/settings/profile", map[string]any{"name": "Ann", "email": "ann@elsewhere.example"})
	app.mail() // the link for the new email

	for _, bad := range []string{old, old + "x", strings.Replace(old, "/verify-email/1/", "/verify-email/2/", 1)} {
		if r := v.get(bad); r.location != "/verify-email" {
			t.Errorf("%s: %d to %q", bad, r.code, r.location)
		}
		r := v.get("/verify-email")
		if msg, _ := r.page.Flash["error"].(string); !strings.HasPrefix(msg, "That link has expired") || r.user()["emailVerifiedAt"] != nil {
			t.Errorf("%s: flash %v, verified %v", bad, r.page.Flash, r.user()["emailVerifiedAt"])
		}
	}
}

func TestAnotherLinkCanBeSentOnceAMinute(t *testing.T) {
	app := newTestApp(t)
	v := app.visitor()
	register(v, "Ann", "ann@example.com", "correct horse")
	app.mail()
	from := []string{"Referer", "http://example.com/settings/profile"}
	if r := v.visit("POST", "/verify-email", nil, from...); r.location != "/settings/profile" {
		t.Fatalf("sending another: %d to %q, want back where it was asked for", r.code, r.location)
	}
	if r := v.get("/settings/profile"); r.page.Flash["success"] != "A new link is on its way to ann@example.com." {
		t.Errorf("flash %v", r.page.Flash)
	}
	link(t, app.mail(), "/verify-email/")

	v.visit("POST", "/verify-email", nil, from...)
	if msg, _ := v.get("/settings/profile").page.Flash["error"].(string); !strings.HasPrefix(msg, "A link went a moment ago") {
		t.Errorf("a second in the minute: flash %q", msg)
	}
	app.noMail()
}

func TestAnEmailHasOneAccount(t *testing.T) {
	app := newTestApp(t)
	register(app.visitor(), "Ann", "ann@example.com", "correct horse")
	v := app.visitor()
	if r := register(v, "Imposter", "ANN@example.com", "correct horse"); r.location != "/" {
		t.Fatalf("registering again: %d to %q, want back to the form", r.code, r.location)
	}
	if r := v.get("/register"); r.errors()["email"] != "email has an account already: log in to it" || r.user() != nil {
		t.Errorf("errors %v, user %v", r.errors(), r.user())
	}
}

func TestRegisteringTakesThePasswordTypedTwice(t *testing.T) {
	app := newTestApp(t)
	v := app.visitor()
	v.visit("POST", "/register", map[string]any{"name": "Ann", "email": "ann@example.com", "password": "correct horse", "password_confirmation": "correct hose"})
	if r := v.get("/register"); r.errors()["password_confirmation"] != "the passwords don't match" {
