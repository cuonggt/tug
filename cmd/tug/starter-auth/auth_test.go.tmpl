// resetLink asks for a reset link for email, and returns its path.
func resetLink(t *testing.T, app *testApp, email string) string {
	t.Helper()
	if r := app.visitor().visit("POST", "/forgot-password", map[string]any{"email": email}); r.location != "/forgot-password" {
		t.Fatalf("asking for a link: %d to %q", r.code, r.location)
	}
	m := app.mail()
	if m.To[0] != email || !strings.HasPrefix(m.Subject, "Reset your") {
		t.Fatalf("mail to %v: %s", m.To, m.Subject)
	}
	return link(t, m, "/reset-password/")
}

// resetPassword follows a reset link in v, and sets password with it.
func resetPassword(t *testing.T, v *visitor, link, password string) response {
	t.Helper()
	r := v.get(link)
	token, _ := r.page.Props["token"].(string)
	if r.page.Component != "Auth/ResetPassword" || token == "" {
		t.Fatalf("the reset page: %d %+v", r.code, r.page)
	}
	return v.visit("POST", "/reset-password", map[string]any{
		"token": token, "email": r.page.Props["email"], "password": password, "password_confirmation": password,
	})
}

func TestAResetLinkSetsANewPasswordOnce(t *testing.T) {
	app := newTestApp(t)
	app.verifiedUser("Ann", "ann@example.com", "correct horse")
	v := app.visitor()
	l := resetLink(t, app, "ann@example.com")
	if r := resetPassword(t, v, l, "battery staple"); r.location != "/dashboard" {
		t.Fatalf("resetting: %d to %q", r.code, r.location)
	}
	if r := v.get("/dashboard"); r.page.Flash["success"] != "Your password is reset." {
		t.Errorf("flash %v", r.page.Flash)
	}
	if r := logIn(app.visitor(), "ann@example.com", "battery staple"); r.location != "/dashboard" {
		t.Errorf("the new password doesn't log in: %d to %q", r.code, r.location)
	}
	again := app.visitor()
	resetPassword(t, again, l, "stolen horse")
	if r := again.get("/"); r.errors()["email"] != "this link has expired, or been used" {
		t.Errorf("the link worked twice: errors %v", r.errors())
	}
}

func TestResettingAPasswordLogsOutTheOtherSessions(t *testing.T) {
	app := newTestApp(t)
	laptop := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	resetPassword(t, app.visitor(), resetLink(t, app, "ann@example.com"), "battery staple")
	if r := laptop.get("/dashboard"); r.location != "/login" {
		t.Errorf("the old login still works: %d to %q", r.code, r.location)
	}
}

func TestResettingAPasswordVerifiesTheEmailItWasSentTo(t *testing.T) {
