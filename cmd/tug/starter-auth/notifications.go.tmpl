// Notifications: what happened to a user's account, which the app tells
// them of in the app, by the header's bell and a page of them, and by
// mail, so its owner hears of a change they didn't make. A handler
// notifies in the transaction that makes the change: as it commits, the
// notification is kept, heard on the user's channel, and mailed, by a job,
// or not at all. Its line is made as it's read, in the reader's language.
// The table's SQL is in notifications_db.go.

// noticeData is what a notification says of its change, kept as JSON: the
// name of the passkey or token it's about, the emails, old and new, or the
// browser of a new login, and its address.
type noticeData struct {
	Name     string `json:"name,omitempty"`
	OldEmail string `json:"oldEmail,omitempty"`
	NewEmail string `json:"newEmail,omitempty"`
	Browser  string `json:"browser,omitempty"`
	IP       string `json:"ip,omitempty"`
}

// A notice is a kind of notification: its line, in the reader's language,
// the page it leads to, and its mail, which leads to mailLink.
type notice struct {
	line     func(c *tug.Ctx, d noticeData) string
	link     string
	mailLink string
	mail     func(u *User, d noticeData, link string) message
}

