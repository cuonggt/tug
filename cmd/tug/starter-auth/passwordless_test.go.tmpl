func TestAnAccountWithNoPasswordSetsAFirstOneWithNoCurrentOne(t *testing.T) {
	app := newTestApp(t)
	c, key := annWithNoPassword(t, app)
	other := app.client()
	passkeyLogin(t, other, key)

	c.Get("/settings/security")
	r := c.Put("/settings/password", map[string]any{"password": "battery staple", "password_confirmation": "battery staple"})
	if r.Location() != "/settings/security" {
		t.Fatalf("setting a password: %v, errors %v", r, r.Follow().Errors())
	}
	if flash, _ := r.Follow().Page.Flash["success"].(string); !strings.HasPrefix(flash, "Password set") {
		t.Errorf("flash %q", flash)
	}
	if u := user(c.Get("/dashboard")); u == nil || !u.Password {
		t.Errorf("this browser, after: %+v", u)
	}
	if r := other.Get("/dashboard"); r.Location() != "/login" {
		t.Errorf("the other login outlived the new password: %v", r)
	}
	if r := logIn(app.client(), "ann@example.com", "battery staple"); r.Location() != "/dashboard" {
		t.Errorf("the password doesn't log in: %v", r)
	}
	mailSaying(t, app, "ann@example.com", "A password was set")
	// With one now, a new one takes the current.
	if errs := c.Put("/settings/password", map[string]any{"password": "stolen horse", "password_confirmation": "stolen horse"}).Follow().Errors(); errs["current_password"] != "current password is required" {
		t.Errorf("a new password with no current one: errors %v", errs)
	}
}

func TestThePasswordIsRemovedOnlyWithAPasskeyToLogInWith(t *testing.T) {
	app := newTestApp(t)
	c := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	c.Get("/settings/security")
	if r := c.Delete("/settings/password", nil); r.Follow().Page.Flash["error"] != "Add a passkey first: an account needs a way in." {
		t.Fatalf("removing the only way in: %v, flash %v", r, r.Follow().Page.Flash)
	}
	if r := logIn(app.client(), "ann@example.com", "correct horse"); r.Location() != "/dashboard" {
		t.Fatalf("the password went: %v", r)
	}

	key := passkeytest.New("https://app.example")
	addPasskey(t, c, key, "Ann's phone")
	other := app.client()
	logIn(other, "ann@example.com", "correct horse")
	r := c.Delete("/settings/password", nil)
	if flash, _ := r.Follow().Page.Flash["success"].(string); !strings.HasPrefix(flash, "Password removed") {
		t.Fatalf("removing it: %v, flash %q", r, flash)
	}
	if u := user(c.Get("/dashboard")); u == nil || u.Password {
		t.Errorf("this browser, after: %+v", u)
	}
	if r := other.Get("/dashboard"); r.Location() != "/login" {
		t.Errorf("the other login outlived the password: %v", r)
	}
	if errs := logIn(app.client(), "ann@example.com", "correct horse").Follow().Errors(); errs["email"] != "the email and password don't match an account" {
		t.Errorf("the old password: errors %v", errs)
	}
	if r := passkeyLogin(t, app.client(), key); r.Location() != "/dashboard" {
		t.Errorf("the passkey doesn't log in: %v", r)
	}
	mailSaying(t, app, "ann@example.com", "password was removed")
}

func TestTheLastPasskeyOfAnAccountWithNoPasswordStays(t *testing.T) {
	app := newTestApp(t)
	c, _ := annWithNoPassword(t, app)
	passkeys := tugtest.Props(c.Get("/settings/security"), Security).Passkeys
	r := c.Delete("/settings/passkeys/"+strconv.FormatInt(passkeys[0].ID, 10), nil)
	if r.Follow().Page.Flash["error"] != "Add a password or another passkey first: an account needs a way in." {
		t.Errorf("removing the last passkey: %v, flash %v", r, r.Follow().Page.Flash)
	}
	if left := tugtest.Props(c.Get("/settings/security"), Security).Passkeys; len(left) != 1 {
		t.Errorf("the passkeys left: %+v", left)
	}

	// With another, either goes.
	addPasskey(t, c, passkeytest.New("https://app.example"), "Ann's laptop")
	if r := c.Delete("/settings/passkeys/"+strconv.FormatInt(passkeys[0].ID, 10), nil); r.Follow().Page.Flash["success"] != "Passkey removed." {
		t.Errorf("removing one of two: %v", r)
	}
}

func TestConfirmingItsYouWithNoPasswordTakesAPasskey(t *testing.T) {
	app := newTestApp(t)
	_, key := annWithNoPassword(t, app)
	c := app.oldLogin("ann@example.com")
	r := c.Get("/settings/security").Follow()
	if props := tugtest.Props(r, ConfirmPassword); r.Page.Component != "Auth/ConfirmPassword" || props.Password || !props.Passkeys {
		t.Fatalf("the confirm page: %v, props %+v", r, props)
	}
	answer, err := key.Get([]byte(c.Post("/confirm-password/passkey/options", nil).Body))
	if err != nil {
		t.Fatal(err)
	}
	if r := c.Post("/confirm-password/passkey", map[string]any{"credential": json.RawMessage(answer)}); r.Location() != "/settings/security" {
		t.Errorf("confirming with the passkey: %v", r)
	}
}

func TestDeletingAnAccountWithNoPasswordTakesAPasskey(t *testing.T) {
	app := newTestApp(t)
	c, key := annWithNoPassword(t, app)
	c.Get("/settings/profile")
	if errs := c.Delete("/settings/profile", map[string]any{}).Follow().Errors(); errs["passkey"] != "confirm it's you with your passkey" {
		t.Fatalf("deleting with nothing: errors %v", errs)
	}
	answer, err := key.Get([]byte(c.Post("/confirm-password/passkey/options", nil).Body))
	if err != nil {
		t.Fatal(err)
	}
	r := c.Delete("/settings/profile", map[string]any{"credential": json.RawMessage(answer)})
	if r.Location() != "/" || r.Follow().Page.Flash["success"] != "Your account is deleted." {
		t.Fatalf("deleting with the passkey: %v", r)
	}
	if _, err := (&users{db: app.db}).byEmail(context.Background(), "ann@example.com"); !errors.Is(err, errNoUser) {
		t.Errorf("the account is still there: %v", err)
	}
}

func TestAResetLinkSetsAFirstPasswordAndKeepsThePasskeys(t *testing.T) {
	app := newTestApp(t)
	_, key := annWithNoPassword(t, app)
	if r := app.client().Post("/forgot-password", map[string]any{"email": "ann@example.com"}); r.Location() != "/forgot-password" {
		t.Fatalf("asking for a link: %v", r)
	}
	m := mailSaying(t, app, "ann@example.com", "Set a password")
	c := app.client()
	if r := resetPassword(t, c, link(t, m, "/reset-password/"), "battery staple"); r.Location() != "/dashboard" {
		t.Fatalf("setting it: %v", r)
	}
	if r := c.Get("/dashboard"); r.Page.Flash["success"] != "Your password is set." || user(r) == nil || !user(r).Password {
		t.Errorf("after: flash %v, user %+v", r.Page.Flash, user(r))
	}
	if r := logIn(app.client(), "ann@example.com", "battery staple"); r.Location() != "/dashboard" {
		t.Errorf("the password doesn't log in: %v", r)
	}
	if r := passkeyLogin(t, app.client(), key); r.Location() != "/dashboard" {
		t.Errorf("the passkey went with the reset: %v", r)
	}
}

func TestAResetLinkOfAnAccountWithNoPasswordAsksForTheCodeAfter(t *testing.T) {
	app := newTestApp(t)
	c, _ := annWithNoPassword(t, app)
	turnOnTwoFactor(t, app, c)
	if r := app.client().Post("/forgot-password", map[string]any{"email": "ann@example.com"}); r.Location() != "/forgot-password" {
		t.Fatalf("asking for a link: %v", r)
	}
	m := mailSaying(t, app, "ann@example.com", "Set a password")
	if r := resetPassword(t, app.client(), link(t, m, "/reset-password/"), "battery staple"); r.Location() != "/two-factor-challenge" {
		t.Errorf("a link in the mail is one factor: %v", r)
	}
}

func TestTheMailOfAChangeSaysWhatToDoAsTheAccountHasAPasswordOrNot(t *testing.T) {
	app := newTestApp(t)
	c, _ := annWithNoPassword(t, app)
	addPasskey(t, c, passkeytest.New("https://app.example"), "Ann's laptop")
	m := mailSaying(t, app, "ann@example.com", "A passkey was added")
	if !strings.Contains(m.Text, "remove the passkeys you don't know") || strings.Contains(m.Text, "change your password") {
		t.Errorf("the mail to an account with no password:\n%s", m.Text)
	}

	bob := app.verifiedUser("Bob", "bob@example.com", "correct horse")
	addPasskey(t, bob, passkeytest.New("https://app.example"), "Bob's phone")
	m = mailSaying(t, app, "bob@example.com", "A passkey was added")
	if !strings.Contains(m.Text, "change your password") {
		t.Errorf("the mail to an account with a password:\n%s", m.Text)
	}
}
