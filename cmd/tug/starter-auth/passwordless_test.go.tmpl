// mailSaying is the next mail to email whose subject says says, past the
// others, as a login's from a new browser.
func mailSaying(t *testing.T, app *testApp, email, says string) mail.Message {
	t.Helper()
	for range 5 {
		if m := app.outbox.NextTo(t, email); strings.Contains(m.Subject, says) {
			return m
		}
	}
	t.Fatalf("no mail to %s says %q", email, says)
	return mail.Message{}
}

// registrationLink asks for a link to register email with a passkey, as
// the register form does, and returns the link mailed to it.
func registrationLink(t *testing.T, app *testApp, name, email string) string {
	t.Helper()
	c := app.client()
	c.Get("/register")
	if r := c.Post("/register/passkey", map[string]any{"name": name, "email": email}); r.Location() != "/register" {
		t.Fatalf("asking for a link: %v, errors %v", r, r.Follow().Errors())
	}
	m := app.outbox.NextTo(t, email)
	if !strings.HasPrefix(m.Subject, "Make your ") {
		t.Fatalf("mail to %v: %s", m.To, m.Subject)
	}
	return link(t, m, "/register/passkey/")
}

// makePasskey follows a registration's link in c, and makes a passkey from
// key with it, as its page does.
func makePasskey(t *testing.T, c *tugtest.Client, link string, key *passkeytest.Authenticator) *tugtest.Response {
	t.Helper()
	page := tugtest.Props(c.Get(link), RegisterPasskey)
	if page.Token == "" {
		t.Fatalf("the page has no token: %+v", page)
	}
	path, query, _ := strings.Cut(link, "?")
	options := c.Post(path+"/options?"+query, nil)
	if options.Code != http.StatusOK {
		t.Fatalf("the options: %v", options)
	}
	answer, err := key.Create([]byte(options.Body))
	if err != nil {
		t.Fatal(err)
	}
	return c.Post(path, map[string]any{"email": page.Email, "name": page.Name, "credential": json.RawMessage(answer)})
}

// annWithNoPassword is Ann, registered with a passkey from key, and logged
// in with it.
func annWithNoPassword(t *testing.T, app *testApp) (*tugtest.Client, *passkeytest.Authenticator) {
	t.Helper()
	c, key := app.client(), passkeytest.New("https://app.example")
	if r := makePasskey(t, c, registrationLink(t, app, "Ann Lee", "ann@example.com"), key); r.Location() != "/dashboard" {
		t.Fatalf("making the passkey: %v, errors %v", r, r.Follow().Errors())
	}
	return c, key
}

func TestRegisteringWithAPasskeyMailsALinkBeforeAnyAccountIsMade(t *testing.T) {
	app := newTestApp(t)
	c := app.client()
	c.Get("/register")
	r := c.Post("/register/passkey", map[string]any{"name": "Ann Lee", "email": "ann@example.com"})
	if r.Location() != "/register" {
		t.Fatalf("asking for a link: %v", r)
	}
	if flash, _ := r.Follow().Page.Flash["success"].(string); !strings.Contains(flash, "We've mailed a link to ann@example.com") {
		t.Errorf("flash %q", flash)
	}
	m := app.outbox.NextTo(t, "ann@example.com")
	l := link(t, m, "/register/passkey/")
	if !strings.Contains(l, "email=ann%40example.com") || !strings.Contains(l, "name=Ann+Lee") {
		t.Errorf("the link %s doesn't say whose", l)
	}
	if _, err := (&users{db: app.db}).byEmail(context.Background(), "ann@example.com"); !errors.Is(err, errNoUser) {
		t.Errorf("an account was made before its email was shown to be the registrant's: %v", err)
	}
}

func TestAPasskeyFromTheLinkMakesAVerifiedAccountWithNoPassword(t *testing.T) {
	app := newTestApp(t)
	c, key := annWithNoPassword(t, app)
	r := c.Get("/dashboard")
	if r.Page.Component != "Dashboard" || r.Page.Flash["success"] != "Welcome, Ann Lee!" {
		t.Fatalf("after: %v, flash %v", r, r.Page.Flash)
	}
	if u := user(r); u == nil || u.Name != "Ann Lee" || u.Password || u.EmailVerifiedAt == nil {
		t.Errorf("the user %+v, want one verified, with no password", u)
	}
	passkeys := tugtest.Props(c.Get("/settings/security"), Security).Passkeys
	if len(passkeys) != 1 || passkeys[0].Name != "A browser" {
		t.Errorf("the passkeys: %+v, want one named for the browser", passkeys)
	}
	app.outbox.None(t) // registering told of nothing

	phone := app.client()
	if r := passkeyLogin(t, phone, key); r.Location() != "/dashboard" {
		t.Errorf("the passkey doesn't log in: %v", r)
	}
	// No password logs in to it, and nothing tells it from a wrong one.
	if errs := logIn(app.client(), "ann@example.com", "correct horse").Follow().Errors(); errs["email"] != "the email and password don't match an account" {
		t.Errorf("logging in with a password: errors %v", errs)
	}
}

func TestARegistrationLinkMakesOneAccount(t *testing.T) {
	app := newTestApp(t)
	l := registrationLink(t, app, "Ann Lee", "ann@example.com")
	if r := makePasskey(t, app.client(), l, passkeytest.New("https://app.example")); r.Location() != "/dashboard" {
		t.Fatalf("making the passkey: %v", r)
	}
	c := app.client()
	r := c.Get(l)
	if r.Location() != "/login" || r.Follow().Page.Flash["error"] != "That email has an account already: log in to it." {
		t.Errorf("the link again: %v", r)
	}
	path, query, _ := strings.Cut(l, "?")
	if r := c.Post(path+"/options?"+query, nil); r.Code != http.StatusUnprocessableEntity {
		t.Errorf("its options again: %v", r)
	}
}

func TestARegistrationLinkChangedOrExpiredMakesNothing(t *testing.T) {
	app := newTestApp(t)
	l := registrationLink(t, app, "Ann Lee", "ann@example.com")
	path, query, _ := strings.Cut(l, "?")
	values, _ := url.ParseQuery(query)
	values.Set("email", "mallory@example.com")
	changed := path + "?" + values.Encode()
	c := app.client()
	if r := c.Get(changed); r.Location() != "/register" || r.Follow().Page.Flash["error"] != "That link has expired, or isn't whole: ask for another." {
		t.Errorf("a link for another email: %v", r)
	}
	if r := c.Post(path+"/options?"+values.Encode(), nil); r.Code != http.StatusUnprocessableEntity {
		t.Errorf("its options: %v", r)
	}
	if r := c.Get("/register/passkey/1." + strings.Repeat("A", 22) + "?" + query); r.Location() != "/register" {
		t.Errorf("a link the app didn't make: %v", r)
	}
}

