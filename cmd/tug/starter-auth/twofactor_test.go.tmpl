package main

import (
	"strings"
	"testing"
	"time"

	"github.com/cuonggt/tug/tugtest"
)

// turnOnTwoFactor turns two-factor logins on for the user logged in to c,
// as they would with their phone, and returns the secret their app has
// and the recovery codes they're shown.
func turnOnTwoFactor(t *testing.T, app *testApp, c *tugtest.Client) (secret string, codes []string) {
	t.Helper()
	if r := c.Post("/settings/two-factor", nil); r.Location() != "/settings/security" {
		t.Fatalf("starting: %v", r)
	}
	setup := tugtest.Props(c.Get("/settings/security"), Security).Setup
	if setup == nil || !strings.HasPrefix(setup.URL, "otpauth://totp/") || !strings.Contains(setup.URL, "secret="+setup.Secret) {
		t.Fatalf("the setup: %+v", setup)
	}
	code, _ := app.twoFactor().Code(setup.Secret, time.Now())
	r := c.Post("/settings/two-factor/confirm", map[string]any{"code": code})
	if r.Location() != "/settings/security" {
		t.Fatalf("confirming: %v", r)
	}
	r = r.Follow()
	[[- /* Two brackets open tug new's placeholders, so a placeholder writes them. */]]
	codes = tugtest.Flash[[ "[[" ]]]string](r, "recoveryCodes")
	if props := tugtest.Props(r, Security); !props.User.TwoFactor || props.Setup != nil || len(codes) != 8 {
		t.Fatalf("once it's on: user %+v, setup %+v, codes %v", props.User, props.Setup, codes)
	}
	return setup.Secret, codes
}

// nextCode is the code the user's app shows 30 seconds on: the one it
// showed now has been used.
func nextCode(t *testing.T, app *testApp, secret string) string {
	t.Helper()
	code, err := app.twoFactor().Code(secret, time.Now().Add(30*time.Second))
	if err != nil {
		t.Fatal(err)
	}
	return code
}

func TestTurningTwoFactorOnTakesACodeFromTheApp(t *testing.T) {
	app := newTestApp(t)
	c := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	c.Post("/settings/two-factor", nil).Follow()
	r := c.Post("/settings/two-factor/confirm", map[string]any{"code": "000000"}).Follow()
	if r.Errors()["code"] != "that code isn't right: try the one your app shows now" || tugtest.Props(r, Security).Setup == nil {
		t.Fatalf("a wrong code: errors %v, setup %v", r.Errors(), r.Page.Props["setup"])
	}
	// Starting afresh makes a new secret, which the first one's code won't fit.
	if setup := tugtest.Props(c.Delete("/settings/two-factor", nil).Follow(), Security).Setup; setup != nil {
		t.Errorf("stopping left the setup: %+v", setup)
	}
	turnOnTwoFactor(t, app, c)
}

func TestLoggingInWithTwoFactorTakesACodeAfterThePassword(t *testing.T) {
	app := newTestApp(t)
	secret, _ := turnOnTwoFactor(t, app, app.verifiedUser("Ann", "ann@example.com", "correct horse"))
	c := app.client()
	if r := logIn(c, "ann@example.com", "correct horse"); r.Location() != "/two-factor-challenge" {
		t.Fatalf("the password: %v", r)
	}
	if r := c.Get("/dashboard"); r.Location() != "/login" {
		t.Fatalf("logged in with the password alone: %v", r)
	}
	if r := c.Get("/two-factor-challenge"); r.Page.Component != "Auth/TwoFactorChallenge" || user(r) != nil {
		t.Fatalf("the challenge: %v, user %+v", r, user(r))
	}
	if errs := c.Post("/two-factor-challenge", map[string]any{"code": "000000"}).Follow().Errors(); errs["code"] != "that code isn't right, or has been used: try the next one" {
		t.Errorf("a wrong code: errors %v", errs)
	}
	code := nextCode(t, app, secret)
	if r := c.Post("/two-factor-challenge", map[string]any{"code": code}); r.Location() != "/dashboard" {
		t.Fatalf("the code: %v", r)
	}
	if u := user(c.Get("/dashboard")); u == nil || u.Name != "Ann" {
		t.Errorf("not logged in after the code: %+v", u)
	}

	// The same code, seen over her shoulder, is no use to anyone else.
	eve := app.client()
	logIn(eve, "ann@example.com", "correct horse")
	eve.Post("/two-factor-challenge", map[string]any{"code": code})
	if r := eve.Get("/dashboard"); r.Location() != "/login" {
		t.Errorf("a code worked twice: %v", r)
	}
}

func TestARecoveryCodeLogsInOnce(t *testing.T) {
	app := newTestApp(t)
	_, codes := turnOnTwoFactor(t, app, app.verifiedUser("Ann", "ann@example.com", "correct horse"))
	c := app.client()
	logIn(c, "ann@example.com", "correct horse")
	// Typed as it might be read out, in capitals.
	if r := c.Post("/two-factor-challenge", map[string]any{"recovery_code": strings.ToUpper(codes[2])}); r.Location() != "/dashboard" {
		t.Fatalf("the code: %v", r)
	}
	again := app.client()
	logIn(again, "ann@example.com", "correct horse")
	again.Post("/two-factor-challenge", map[string]any{"recovery_code": codes[2]})
	if r := again.Get("/two-factor-challenge"); r.Errors()["recovery_code"] != "that isn't one of your recovery codes, or it has been used" {
		t.Errorf("the code, used again: errors %v", r.Errors())
	}
}

func TestTooManyWrongCodesWaitAMinute(t *testing.T) {
	app := newTestApp(t)
	secret, _ := turnOnTwoFactor(t, app, app.verifiedUser("Ann", "ann@example.com", "correct horse"))
	c := app.client()
	logIn(c, "ann@example.com", "correct horse")
	for range 5 {
		c.Post("/two-factor-challenge", map[string]any{"code": "000000"})
	}
	c.Post("/two-factor-challenge", map[string]any{"code": nextCode(t, app, secret)})
	if msg := c.Get("/two-factor-challenge").Errors()["code"]; !strings.HasPrefix(msg, "too many tries: wait ") {
		t.Errorf("errors %q", msg)
	}
}

func TestTheChallengeComesAfterThePassword(t *testing.T) {
	app := newTestApp(t)
	c := app.client()
	if r := c.Get("/two-factor-challenge"); r.Location() != "/login" {
		t.Errorf("the challenge, with no password given: %v", r)
	}
	if r := c.Post("/two-factor-challenge", map[string]any{"code": "123456"}); r.Location() != "/login" {
		t.Errorf("a code, with no password given: %v", r)
	}
}

func TestTurningTwoFactorOffLeavesThePasswordAlone(t *testing.T) {
	app := newTestApp(t)
	c := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	turnOnTwoFactor(t, app, c)
	r := c.Delete("/settings/two-factor", nil).Follow()
	if u := tugtest.Props(r, Security).User; r.Page.Flash["success"] != "Two-factor logins are off." || u.TwoFactor {
		t.Fatalf("flash %v, user %+v", r.Page.Flash, u)
	}
	if r := logIn(app.client(), "ann@example.com", "correct horse"); r.Location() != "/dashboard" {
		t.Errorf("logging in: %v", r)
	}
}

func TestRecoveryCodesCanBeSeenAgainAndReplaced(t *testing.T) {
	app := newTestApp(t)
	c := app.verifiedUser("Ann", "ann@example.com", "correct horse")
	_, codes := turnOnTwoFactor(t, app, c)
	if r := c.Get("/settings/security"); r.Has("recoveryCodes") {
		t.Error("the codes went out with the page, unasked")
	}
	if shown := tugtest.Prop[[ "[[" ]]]string](c.Reload(tugtest.Only("recoveryCodes")), "recoveryCodes"); len(shown) != 8 || shown[0] != codes[0] {
		t.Fatalf("asked for, the codes are %v", shown)
	}

	fresh := tugtest.Flash[[ "[[" ]]]string](c.Post("/settings/two-factor/recovery-codes", nil).Follow(), "recoveryCodes")
	if len(fresh) != 8 || fresh[0] == codes[0] {
		t.Fatalf("new codes %v", fresh)
	}
	login := app.client()
	logIn(login, "ann@example.com", "correct horse")
	login.Post("/two-factor-challenge", map[string]any{"recovery_code": codes[0]})
	if r := login.Get("/dashboard"); r.Location() != "/login" {
		t.Error("an old recovery code still works")
	}
	if r := login.Post("/two-factor-challenge", map[string]any{"recovery_code": fresh[0]}); r.Location() != "/dashboard" {
		t.Errorf("a new recovery code: %v", r)
	}
}

func TestAResetPasswordStillTakesTheSecondFactor(t *testing.T) {
	app := newTestApp(t)
	secret, _ := turnOnTwoFactor(t, app, app.verifiedUser("Ann", "ann@example.com", "correct horse"))
	c := app.client()
	if r := resetPassword(t, c, resetLink(t, app, "ann@example.com"), "battery staple"); r.Location() != "/two-factor-challenge" {
		t.Fatalf("resetting: %v", r)
	}
	if r := c.Get("/dashboard"); r.Location() != "/login" {
		t.Fatalf("logged in by the reset alone: %v", r)
	}
	if r := c.Get("/two-factor-challenge"); r.Page.Component != "Auth/TwoFactorChallenge" || r.Page.Flash["success"] != "Your password is reset." {
		t.Fatalf("the challenge after the reset: %v, flash %v", r, r.Page.Flash)
	}
	if r := c.Post("/two-factor-challenge", map[string]any{"code": nextCode(t, app, secret)}); r.Location() != "/dashboard" {
		t.Errorf("the code after the reset: %v", r)
	}
}

func TestTwoFactorSecretsMoveToANewKey(t *testing.T) {
	old := newTestApp(t)
	secret, _ := turnOnTwoFactor(t, old, old.verifiedUser("Ann", "ann@example.com", "correct horse"))

	// A deploy with a new APP_KEY, and the old one in APP_PREVIOUS_KEYS,
	// then one without the old key.
	startApp(t, old.db, [][]byte{key(2), key(1)})
	app := startApp(t, old.db, [][]byte{key(2)})
	c := app.client()
	logIn(c, "ann@example.com", "correct horse")
	if r := c.Post("/two-factor-challenge", map[string]any{"code": nextCode(t, app, secret)}); r.Location() != "/dashboard" {
		t.Errorf("the code, with the old key gone: %v", r)
	}
}
