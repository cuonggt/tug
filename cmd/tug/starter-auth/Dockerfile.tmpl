[[ if and .SSR .SQLite -]]
# The app as one static binary, frontend and SSR bundle included, on an
# image with Node, which renders the pages on the server beside it. The
# database, and the files people upload, are in /data, a volume, so they
# outlive the container:
[[ else if .SSR -]]
# The app as one static binary, frontend and SSR bundle included, on an
# image with Node, which renders the pages on the server beside it. The
# database is wherever DB_URL says, and the files people upload are in
# /data, a volume, so they outlive the container, unless they're in S3:
[[ else if .SQLite -]]
# The app as one static binary, frontend included, on an image with nothing
# else in it. The database, and the files people upload, are in /data, a
# volume, so they outlive the container:
[[ else -]]
# The app as one static binary, frontend included, on an image with nothing
# else in it. The database is wherever DB_URL says, and the files people
# upload are in /data, a volume, so they outlive the container, unless
# they're in S3:
[[ end -]]
#
#   docker build -t app . && docker run -p 8080:8080 -v app-data:/data \
[[ if .SQLite -]]
#     -e APP_KEY=... -e APP_URL=https://example.com \
[[ else -]]
#     -e APP_KEY=... -e APP_URL=https://example.com -e DB_URL=... \
[[ end -]]
#     -e MAIL_HOST=... -e MAIL_FROM_ADDRESS=... app
#
# Or serving HTTPS itself, on a machine of its own, with a certificate from
# Let's Encrypt for each of TLS_DOMAINS, kept on the volume too, so a new
# container doesn't ask again: -p 443:443 -p 80:80 -e TLS_DOMAINS=example.com.

FROM node:24-alpine AS frontend
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM golang:1.26-alpine AS server
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /app/public/build public/build
[[ if .SSR -]]
COPY --from=frontend /app/ssr/build ssr/build
[[ end -]]
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /server . && mkdir /data

[[ if .SSR -]]
FROM gcr.io/distroless/nodejs24-debian12
ENV SSR_NODE=/nodejs/bin/node
[[ else -]]
FROM gcr.io/distroless/static-debian12
[[ end -]]
COPY --from=server /server /server
[[ if .SQLite -]]
# 65532 is the image's nonroot user, who has to be able to write the database.
COPY --from=server --chown=65532:65532 /data /data
ENV DB_PATH=/data/app.db FILES_PATH=/data/files CERTS_PATH=/data/certs
[[ else -]]
# 65532 is the image's nonroot user, who has to be able to write the files.
COPY --from=server --chown=65532:65532 /data /data
ENV FILES_PATH=/data/files CERTS_PATH=/data/certs
[[ end -]]
# The app listens on :8080, or on the PORT a platform sets; or with
# TLS_DOMAINS, or TLS_CERT and TLS_KEY, on :443 and :80.
EXPOSE 8080 443 80
VOLUME /data
USER nonroot:nonroot
ENTRYPOINT ["/server"]
