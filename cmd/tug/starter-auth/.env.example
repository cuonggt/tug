# Copy to .env, which tug dev reads. APP_KEY encrypts the sessions and the
# two-factor secrets, and signs the links in the app's mail: make one with
# `head -c 32 /dev/urandom | base64`, and write it as base64:<that>. To
# change it, move the old one to APP_PREVIOUS_KEYS, comma separated, for a
# month, as long as a remembered login lasts: sessions and links made with
# it still work meanwhile, and the app seals the two-factor secrets again
# with the new one as it starts.
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true

# The app's own address, which the links in its mail start with, such as
# https://example.com. Only in development, with APP_DEBUG on, can it be
# left out. With https://, the session cookie is for HTTPS only.
APP_URL=

# Where the SQLite database is. Default app.db.
DB_PATH=app.db

# How many background jobs, such as mail, the app runs at once. With 0 it
# runs none, and leaves its jobs to another instance on the same database.
QUEUE_WORKERS=4

# The SMTP server that sends the app's mail. Without MAIL_HOST, mail is
# written out where tug dev shows it instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
