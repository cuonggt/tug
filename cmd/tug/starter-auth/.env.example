# Copy to .env, which tug dev reads. APP_KEY encrypts the sessions and signs
# password reset links: make one with `head -c 32 /dev/urandom | base64`,
# and write it as base64:<that>.
APP_KEY=
APP_DEBUG=true

# The app's own address, which the links in its mail start with, such as
# https://example.com. Only in development, with APP_DEBUG on, can it be
# left out.
APP_URL=

# Where the SQLite database is. Default app.db.
DB_PATH=app.db

# The SMTP server that sends the app's mail. Without MAIL_HOST, mail is
# written out where tug dev shows it instead.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
