<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
[[- if .SSR ]]
    {{/* What the page rendered on the server puts in the head, its own
         <title> first: the one after it is for a page without one. */}}
    {{ .InertiaHead }}
[[- end ]]
    <title data-inertia>[[ .Name ]]</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23171717'/%3E%3C/svg%3E">
    {{/* Light or dark before the page paints, rather than a flash of the
         wrong one: the choice on the appearance page, kept in the browser,
         or else the system's. resources/js/hooks/use-appearance.ts keeps
         it from then on. */}}
    <script>
      (function () {
        var appearance = localStorage.getItem('appearance')
        var dark = appearance === 'dark' || (appearance !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', dark)
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
      })()
    </script>
    <style>
      html { background-color: oklch(1 0 0); }
      html.dark { background-color: oklch(0.145 0 0); }
    </style>
    {{ viteReactRefresh }}
    {{/* The page's own component loads alongside the app, not after it. */}}
    {{ vite "resources/js/app.tsx" (printf "resources/js/pages/%s.tsx" .Page.Component) }}
  </head>
  <body>
    {{ .Inertia }}
  </body>
</html>
