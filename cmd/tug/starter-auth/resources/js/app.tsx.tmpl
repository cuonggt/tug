import { createInertiaApp, router, type ResolvedComponent } from '@inertiajs/react'
import { createRoot } from 'react-dom/client'
import { toast } from 'sonner'
import { Toaster } from '@/components/ui/sonner'
import { followAppearance } from '@/hooks/use-appearance'
import AppLayout from '@/layouts/app-layout'
import AuthLayout from '@/layouts/auth-layout'
import SettingsLayout from '@/layouts/settings-layout'
import '../css/app.css'

// Each page is its own chunk, loaded when a visit needs it. The Go server's
// root template loads the first page's alongside this file.
const pages = import.meta.glob<{ default: ResolvedComponent }>('./pages/**/*.tsx')

// What a handler flashes with c.Flash("success", ...), or "error", shows
// as a toast. Listening from the start catches the flash that comes with
// the first page, as after following a link in the app's mail.
router.on('flash', (event) => {
  const { success, error } = event.detail.flash
  if (success) toast.success(success)
  if (error) toast.error(error)
})

createInertiaApp({
  title: (title) => (title ? `${title} · [[ .Name ]]` : '[[ .Name ]]'),
  resolve: async (name) => {
    const load = pages[`./pages/${name}.tsx`]
    if (!load) {
      throw new Error(`There's no page component at resources/js/pages/${name}.tsx`)
    }
    return (await load()).default
  },
  // A page's layout goes by its name: the card for logging in and the rest
  // of Auth/, the settings' own inside the app's for Settings/, and the
  // app's for the others. Home is the landing page, which has none. A page
  // gives its layout props with a static layout, as Login.layout does.
  layout: (name) => {
    if (name === 'Home') return null
    if (name.startsWith('Auth/')) return AuthLayout
    if (name.startsWith('Settings/')) return [AppLayout, SettingsLayout]
    return AppLayout
  },
  setup({ el, App, props }) {
    createRoot(el).render(
      <>
        <App {...props} />
        <Toaster />
      </>,
    )
  },
  progress: { color: '#737373' },
})

followAppearance()
