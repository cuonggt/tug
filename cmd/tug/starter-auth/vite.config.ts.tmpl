import fs from 'node:fs'
import { fileURLToPath } from 'node:url'
import tailwindcss from '@tailwindcss/vite'
[[- if .SSR ]]
import inertia from '@inertiajs/vite'
[[- end ]]
import react from '@vitejs/plugin-react'
import { defineConfig, type Plugin } from 'vite'

const devServer = 'http://localhost:5173'

// The Go server serves the build from public/build under /build/, and
// finds the dev server through public/hot.
[[- if .SSR ]]
// `vite build --ssr` builds ssr.tsx into ssr/build, which the Go server
// embeds, and runs with Node to render pages on the server; under tug dev,
// @inertiajs/vite has the dev server render them.
export default defineConfig(({ command, isSsrBuild }) => ({
[[- else ]]
export default defineConfig(({ command }) => ({
[[- end ]]
  base: command === 'build' ? '/build/' : '/',
  // public/ is the Go server's to serve; the build goes inside it.
  publicDir: false,
[[- if .SSR ]]
  plugins: [react(), tailwindcss(), inertia({ ssr: { sourcemap: false } }), tug()],
[[- else ]]
  plugins: [react(), tailwindcss(), tug()],
[[- end ]]
  // @/components/ui/button is resources/js/components/ui/button.tsx, as
  // tsconfig.json's paths say too, and as shadcn's components import them.
  resolve: {
    alias: { '@': fileURLToPath(new URL('./resources/js', import.meta.url)) },
  },
[[- if .SSR ]]
  build: isSsrBuild
    ? {
        outDir: 'ssr/build',
        emptyOutDir: true,
        rolldownOptions: {
          input: 'resources/js/ssr.tsx',
          output: { entryFileNames: '[name].mjs', chunkFileNames: '[name]-[hash].mjs' },
        },
      }
    : {
        manifest: true,
        outDir: 'public/build',
        emptyOutDir: true,
        rolldownOptions: { input: 'resources/js/app.tsx' },
      },
  // The SSR bundle takes its packages with it, to run where node_modules
  // isn't, as in the app's image.
  ssr: isSsrBuild ? { noExternal: true } : undefined,
[[- else ]]
  build: {
    manifest: true,
    outDir: 'public/build',
    emptyOutDir: true,
    rolldownOptions: { input: 'resources/js/app.tsx' },
  },
[[- end ]]
  server: {
    port: 5173,
    strictPort: true,
    // The page comes from the Go server, so the files it loads must name
    // the dev server in full.
    origin: devServer,
  },
}))

// tug tells the Go server where the dev server is, by writing its URL to
// public/hot while it runs, and reloads the browser when tug dev has
// restarted the Go server, which it says by touching .tug/reload.
function tug(): Plugin {
  const hot = 'public/hot'
  const reload = '.tug/reload'
  return {
    name: 'tug',
    apply: 'serve',
    configureServer(server) {
      server.httpServer?.once('listening', () => fs.writeFileSync(hot, devServer))
      process.on('exit', () => fs.rmSync(hot, { force: true }))
      for (const signal of ['SIGINT', 'SIGTERM', 'SIGHUP'] as const) {
        process.on(signal, () => process.exit())
      }
      server.watcher.add(reload)
      const onReload = (file: string) => {
        if (file.endsWith(reload)) {
          server.ws.send({ type: 'full-reload' })
        }
      }
      server.watcher.on('add', onReload)
      server.watcher.on('change', onReload)
    },
  }
}
