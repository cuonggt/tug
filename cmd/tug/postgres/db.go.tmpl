package main

import (
	"cmp"
	"context"
	"database/sql"
	"errors"
	"fmt"
	"net"
	"net/url"
	"os"

	"github.com/jackc/pgx/v5/pgconn"
	_ "github.com/jackc/pgx/v5/stdlib" // Postgres in pure Go, so the binary stays static
)

// The app's database is Postgres, at DB_URL, which compose.yaml runs in
// development: docker compose up -d. This file opens it; migrations/ makes
// its tables, as the app starts (migrations.go); and the SQL of each is
// beside the Go that's the same on any database: users_db.go,
// passkeys_db.go, jobs_db.go, throttles_db.go, cache_db.go, tokens_db.go,
// broadcasts_db.go, notifications_db.go and migrations_db.go.

// dbFromEnv opens the database the environment names: DB_URL, with the
// driver's settings in its query, as
//
//	postgres://user:password@host:5432/[[ .DBName ]]?sslmode=require
//
// or else DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME and DB_PASSWORD, as
// Laravel names them.
func dbFromEnv() (*sql.DB, error) {
	u := os.Getenv("DB_URL")
	if u == "" && os.Getenv("DB_HOST") == "" {
		return nil, errors.New("DB_URL isn't set: the app's database is Postgres, at a URL such as postgres://user:password@host:5432/[[ .DBName ]], or DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME and DB_PASSWORD")
	}
	if u == "" {
		u = (&url.URL{
			Scheme: "postgres",
			User:   url.UserPassword(os.Getenv("DB_USERNAME"), os.Getenv("DB_PASSWORD")),
			Host:   net.JoinHostPort(os.Getenv("DB_HOST"), cmp.Or(os.Getenv("DB_PORT"), "5432")),
			Path:   os.Getenv("DB_DATABASE"),
		}).String()
	}
	db, err := openDB(u)
	var dial *net.OpError
	if errors.As(err, &dial) && dial.Op == "dial" {
		return nil, fmt.Errorf("%w: in development, `docker compose up -d` starts the database compose.yaml has", err)
	}
	return db, err
}

// openDB opens the Postgres database at url, and connects, so a server
// that isn't there is said as the app starts.
func openDB(url string) (*sql.DB, error) {
	db, err := sql.Open("pgx", url)
	if err != nil {
		return nil, err
	}
	if err := db.PingContext(context.Background()); err != nil {
		db.Close()
		return nil, err
	}
	return db, nil
}

// uniqueViolation is Postgres's code for a write that a unique index
// turned away.
const uniqueViolation = "23505"

// taken says whether err is a write that a unique index turned away, as
// for an email that has an account already. In a transaction, it ends
// what the transaction can do: it's rolled back.
func taken(err error) bool {
	var pgErr *pgconn.PgError
	return errors.As(err, &pgErr) && pgErr.Code == uniqueViolation
}
