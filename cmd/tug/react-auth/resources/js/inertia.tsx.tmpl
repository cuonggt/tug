import { createInertiaApp, type ResolvedComponent } from '@inertiajs/react'
import { Toaster } from '@/components/ui/sonner'
import AppLayout from '@/layouts/app-layout'
import AuthLayout from '@/layouts/auth-layout'
import SettingsLayout from '@/layouts/settings-layout'
import '../css/app.css'

// Each page is its own chunk, loaded when a visit needs it. The Go server's
// root template loads the first page's alongside app.tsx.
const pages = import.meta.glob<{ default: ResolvedComponent }>('./pages/**/*.tsx')

// createApp makes the app. In the browser, app.tsx's call renders the page,
// or takes over the HTML the server rendered of it; on the server, with
// server-side rendering, ssr.tsx's returns what renders a page to HTML.
export function createApp() {
  return createInertiaApp({
    title: (title) => (title ? `${title} · [[ .Name ]]` : '[[ .Name ]]'),
    resolve: async (name) => {
      const load = pages[`./pages/${name}.tsx`]
      if (!load) {
        throw new Error(`There's no page component at resources/js/pages/${name}.tsx`)
      }
      return (await load()).default
    },
    // A page's layout goes by its name: the card for logging in and the
    // rest of Auth/, the settings' own inside the app's for Settings/, and
    // the app's for the others. Home is the landing page, which has none.
    // A page gives its layout props with a static layout, as Login.layout
    // does.
    layout: (name) => {
      if (name === 'Home') return null
      if (name.startsWith('Auth/')) return AuthLayout
      if (name.startsWith('Settings/')) return [AppLayout, SettingsLayout]
      return AppLayout
    },
    withApp: (app) => (
      <>
        {app}
        <Toaster />
      </>
    ),
    progress: { color: '#737373' },
  })
}
