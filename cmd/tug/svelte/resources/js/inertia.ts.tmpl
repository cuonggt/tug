import { createInertiaApp, type ResolvedComponent } from '@inertiajs/svelte'
import '../css/app.css'

// Each page is its own chunk, loaded when a visit needs it. The Go server's
// root template loads the first page's alongside app.ts.
const pages = import.meta.glob<ResolvedComponent>('./pages/**/*.svelte')

// createApp makes the app. In the browser, app.ts's call renders the page,
// or takes over the HTML the server rendered of it; on the server, with
// server-side rendering, ssr.ts's returns what renders a page to HTML. A
// page's title is Head.svelte's.
export function createApp() {
  return createInertiaApp({
    resolve: async (name) => {
      const load = pages[`./pages/${name}.svelte`]
      if (!load) {
        throw new Error(`There's no page component at resources/js/pages/${name}.svelte`)
      }
      return load()
    },
    progress: { color: '#0e7490' },
  })
}
