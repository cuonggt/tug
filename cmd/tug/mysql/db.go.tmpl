package main

import (
	"cmp"
	"context"
	"database/sql"
	"errors"
	"fmt"
	"net"
	"net/url"
	"os"
	"strings"
	"time"

	"github.com/go-sql-driver/mysql" // MySQL in pure Go, so the binary stays static
)

// The app's database is MySQL, at DB_URL, which compose.yaml runs in
// development: docker compose up -d. This file opens it; migrations/ makes
// its tables, as the app starts (migrations.go); and the SQL of each is
// beside the Go that's the same on any database: users_db.go,
// passkeys_db.go, jobs_db.go, throttles_db.go, cache_db.go, tokens_db.go,
// broadcasts_db.go, notifications_db.go and migrations_db.go.

// dbFromEnv opens the database the environment names: DB_URL, with the
// driver's settings in its query, as
//
//	mysql://user:password@host:3306/[[ .DBName ]]?tls=true
//
// or else DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME and DB_PASSWORD, as
// Laravel names them.
func dbFromEnv() (*sql.DB, error) {
	u := os.Getenv("DB_URL")
	if u == "" && os.Getenv("DB_HOST") == "" {
		return nil, errors.New("DB_URL isn't set: the app's database is MySQL, at a URL such as mysql://user:password@host:3306/[[ .DBName ]], or DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME and DB_PASSWORD")
	}
	if u == "" {
		u = (&url.URL{
			Scheme: "mysql",
			User:   url.UserPassword(os.Getenv("DB_USERNAME"), os.Getenv("DB_PASSWORD")),
			Host:   net.JoinHostPort(os.Getenv("DB_HOST"), cmp.Or(os.Getenv("DB_PORT"), "3306")),
			Path:   os.Getenv("DB_DATABASE"),
		}).String()
	}
	db, err := openDB(u)
	var dial *net.OpError
	if errors.As(err, &dial) && dial.Op == "dial" {
		return nil, fmt.Errorf("%w: in development, `docker compose up -d` starts the database compose.yaml has", err)
	}
	return db, err
}

// openDB opens the MySQL database at url, a mysql:// URL, and connects, so
// a server that isn't there is said as the app starts.
func openDB(url string) (*sql.DB, error) {
	cfg, err := config(url)
	if err != nil {
		return nil, err
	}
	connector, err := mysql.NewConnector(cfg)
	if err != nil {
		return nil, err
	}
	db := sql.OpenDB(connector)
	// MySQL closes a connection that's been idle for a while, which the pool
	// would find out by a query that fails: it lets them go first.
	db.SetConnMaxLifetime(3 * time.Minute)
	if err := db.PingContext(context.Background()); err != nil {
		db.Close()
		return nil, err
	}
	return db, nil
}

// config is the driver's config for a mysql:// URL, whose query has the
// driver's settings, as its own DSN does. A connection's time zone is UTC,
// for CURRENT_TIMESTAMP and the DATETIME columns, and each statement it
// runs reads what's committed as it runs, as in Postgres, rather than what
// was as its transaction began: READ COMMITTED. The driver writes a
// query's arguments into it, escaped for its utf8mb4, so that it goes in
// one round trip, rather than three, to prepare it, run it and close it.
func config(s string) (*mysql.Config, error) {
	u, err := url.Parse(s)
	if err != nil || u.Scheme != "mysql" {
		return nil, errors.New("the database's URL isn't a mysql:// one, such as mysql://user:password@host:3306/[[ .DBName ]]")
	}
	if strings.Trim(u.Path, "/") == "" {
		return nil, errors.New("the database's URL names no database, as mysql://user:password@host:3306/[[ .DBName ]] does")
	}
	cfg := mysql.NewConfig()
	cfg.User = u.User.Username()
	cfg.Passwd, _ = u.User.Password()
	cfg.Net, cfg.Addr, cfg.DBName = "tcp", u.Host, strings.Trim(u.Path, "/")
	dsn := cfg.FormatDSN()
	if u.RawQuery != "" {
		dsn += "?" + u.RawQuery
	}
	if cfg, err = mysql.ParseDSN(dsn); err != nil {
		return nil, fmt.Errorf("the database's URL: %w", err)
	}
	cfg.ParseTime, cfg.Loc, cfg.InterpolateParams = true, time.UTC, true
	if cfg.Params == nil {
		cfg.Params = map[string]string{}
	}
	cfg.Params["time_zone"] = "'+00:00'"
	cfg.Params["transaction_isolation"] = "'READ-COMMITTED'"
	return cfg, nil
}

// taken says whether err is a write that a unique index turned away, as
// for an email that has an account already: MySQL's error 1062. The
// transaction it was in goes on without it.
func taken(err error) bool {
	var myErr *mysql.MySQLError
	return errors.As(err, &myErr) && myErr.Number == 1062
}
