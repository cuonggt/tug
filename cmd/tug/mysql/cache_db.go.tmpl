package main

import (
	"context"
	"database/sql"
	"errors"
	"time"
)

// cacheTable is the cache's values, and its locks, in the database, where
// every instance of the app finds them: a cache.Store, for the
// cache.Cache newApp makes. A row is a key's value, and when it expires,
// in Unix milliseconds, as a job's times are. The key is the SHA-256
// package cache makes of the app's, so the table keeps no email, say, that
// a key has in it.
type cacheTable struct {
	db *sql.DB
}

func (ct *cacheTable) Get(ctx context.Context, key []byte, now time.Time) ([]byte, bool, error) {
	var value []byte
	err := ct.db.QueryRowContext(ctx, "SELECT value FROM cache WHERE key_hash = ? AND expires_at > ?", key, now.UnixMilli()).Scan(&value)
	if errors.Is(err, sql.ErrNoRows) {
		return nil, false, nil
	}
	if err != nil {
		return nil, false, err
	}
	return value, true, nil
}

func (ct *cacheTable) Set(ctx context.Context, key, value []byte, expires time.Time) error {
	_, err := ct.db.ExecContext(ctx, `
		INSERT INTO cache (key_hash, value, expires_at) VALUES (?, ?, ?) AS kept
		ON DUPLICATE KEY UPDATE value = kept.value, expires_at = kept.expires_at`,
		key, value, expires.UnixMilli())
	return err
}

// Add keeps value in one statement: an upsert that replaces only a value
// that has expired, and so changes no row where the key's hasn't, which
// MySQL counts as none affected. MySQL sets an UPDATE's columns in order,
// each from the row as the ones before left it: the value, which reads the
// time it expires, goes first. The upsert of a key another instance is
// adding waits for it, then finds its value.
func (ct *cacheTable) Add(ctx context.Context, key, value []byte, expires, now time.Time) (bool, error) {
	res, err := ct.db.ExecContext(ctx, `
		INSERT INTO cache (key_hash, value, expires_at) VALUES (?, ?, ?) AS added
		ON DUPLICATE KEY UPDATE
			value = IF(cache.expires_at <= ?, added.value, cache.value),
			expires_at = IF(cache.expires_at <= ?, added.expires_at, cache.expires_at)`,
		key, value, expires.UnixMilli(), now.UnixMilli(), now.UnixMilli())
	if err != nil {
		return false, err
	}
	n, err := res.RowsAffected()
	return n > 0, err
}

func (ct *cacheTable) Delete(ctx context.Context, key []byte) error {
	_, err := ct.db.ExecContext(ctx, "DELETE FROM cache WHERE key_hash = ?", key)
	return err
}

func (ct *cacheTable) DeleteIf(ctx context.Context, key, value []byte) (bool, error) {
	res, err := ct.db.ExecContext(ctx, "DELETE FROM cache WHERE key_hash = ? AND value = ?", key, value)
	if err != nil {
		return false, err
	}
	n, err := res.RowsAffected()
	return n == 1, err
}

// prune deletes the values that have expired, which Get leaves out
// already, for the room they take. It's a job, which newApp schedules for
// every hour.
func (ct *cacheTable) prune(ctx context.Context, _ struct{}) error {
	_, err := ct.db.ExecContext(ctx, "DELETE FROM cache WHERE expires_at <= ?", time.Now().UnixMilli())
	return err
}
