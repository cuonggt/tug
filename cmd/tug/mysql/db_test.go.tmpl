)

// testServer is the MySQL the tests make their databases on: the one
// DB_URL names, or else compose.yaml's, which `docker compose up -d`
// starts. With none, every test fails, saying so: skipped, they would
// pass with nothing tested.
var testServer = sync.OnceValues(func() (*server, error) {
	u, err := url.Parse(cmp.Or(os.Getenv("DB_URL"), "[[ .DevURL ]]"))
	if err != nil {
		return nil, fmt.Errorf("DB_URL isn't a URL: %w", err)
	}
	cfg, err := config(u.String())
	if err != nil {
		return nil, err
	}
	connector, err := mysql.NewConnector(cfg)
	if err != nil {
		return nil, err
	}
	db := sql.OpenDB(connector)
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()
	if err := db.PingContext(ctx); err != nil {
		db.Close()
		return nil, fmt.Errorf("the tests make their databases on a MySQL, and couldn't connect to the one at %s: start compose.yaml's with `docker compose up -d`, or name another with DB_URL: %w", u.Redacted(), err)
	}
	return &server{url: u, db: db}, nil
})

// server is a MySQL the tests make databases on, through db, a connection
// to the database its url names.
type server struct {
	url *url.URL
	db  *sql.DB
}

// testDB is a database of the test's own, with its tables made.
func testDB(t *testing.T) *sql.DB {
	t.Helper()
	db := newDB(t)()
	if err := upToDate(t.Context(), db); err != nil {
		t.Fatal(err)
	}
	return db
}

// newDB makes an empty database of the test's own, and returns what opens
// it, as each instance of the app does, as many times as the test likes.
func newDB(t *testing.T) (open func() *sql.DB) {
	t.Helper()
	u := newTestDatabase(t)
	return func() *sql.DB {
		t.Helper()
		db, err := openDB(u)
		if err != nil {
			t.Fatal(err)
		}
		t.Cleanup(func() { db.Close() })
		return db
	}
}

// newTestDatabase makes an empty database for the test alone, which is
// dropped once it's over, and returns its URL.
func newTestDatabase(t *testing.T) string {
	t.Helper()
	s, err := testServer()
	if err != nil {
		t.Fatal(err)
	}
	name := "[[ .DBName ]]_test_" + strings.ToLower(rand.Text()[:8])
	if _, err := s.db.Exec("CREATE DATABASE " + name); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() {
		if _, err := s.db.Exec("DROP DATABASE " + name); err != nil {
			t.Errorf("dropping the test's database: %v", err)
		}
	})
	u := *s.url
	u.Path = "/" + name
	return u.String()
}

// jobsDown has the jobs table turn every new job away, as a database can,
// while the queue's claims go on.
func jobsDown(t *testing.T, db *sql.DB) {
	t.Helper()
	if _, err := db.Exec("CREATE TRIGGER jobs_down BEFORE INSERT ON jobs FOR EACH ROW SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'no room for the job'"); err != nil {
		t.Fatal(err)
	}
}

// failedDaysAgo has the job with id have failed days ago, by the
// database's clock, as prune reads it.
func failedDaysAgo(t *testing.T, db *sql.DB, id string, days int) {
	t.Helper()
	if _, err := db.Exec("UPDATE jobs SET failed_at = CURRENT_TIMESTAMP(6) - INTERVAL ? DAY WHERE id = ?", days, jobID(id)); err != nil {
		t.Fatal(err)
	}
}

// oldCount counts n steps as having run, as an app made before its
// migrations were files did, in the schema_version table.
func oldCount(t *testing.T, db *sql.DB, n int) {
	t.Helper()
	if _, err := db.Exec("CREATE TABLE schema_version (version INT NOT NULL, running INT)"); err != nil {
		t.Fatal(err)
	}
	if _, err := db.Exec("INSERT INTO schema_version (version) VALUES (?)", n); err != nil {
		t.Fatal(err)
	}
}

// oldCountGone reports whether db has no count of steps left.
func oldCountGone(t *testing.T, db *sql.DB) bool {
	t.Helper()
	var n int
	if err := db.QueryRow("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name = 'schema_version'").Scan(&n); err != nil {
		t.Fatal(err)
	}
	return n == 0
}

// execSQL runs a migration's SQL on db, a statement at a time, as a step
// of an app made before ran, with no record of it.
func execSQL(t *testing.T, db *sql.DB, sql string) {
	t.Helper()
	for _, stmt := range statements(sql) {
		if _, err := db.Exec(stmt); err != nil {
			t.Fatal(err)
		}
	}
}

func TestAMigrationWhoseLaterStatementFailedStopsTheNextRunWhereItDid(t *testing.T) {
	s := &migrationsTable{db: newDB(t)()}
	twice := migrate.Migration{Name: "20261001093000_twice", Up: "CREATE TABLE twice (id INT);\nCREATE TABLE twice (id INT);"}
	_, err := migrate.Up(t.Context(), s, []migrate.Migration{twice})
	if err == nil || !strings.Contains(err.Error(), "its statement 2 failed, after the 1 before it ran") {
		t.Fatalf("the statement that failed: %v", err)
	}
	// The next run says where, rather than run the first again.
	want := "migrations/20261001093000_twice.sql stopped at its statement 2, after those before it ran"
	if _, err := migrate.Up(t.Context(), s, []migrate.Migration{twice}); err == nil || !strings.HasPrefix(err.Error(), want) {
		t.Errorf("the next run: %v, want %q", err, want)
	}
}

func TestAMigrationTheAppStoppedInIsNamedNotGuessed(t *testing.T) {
	db := testDB(t)
	// As a crash while the down part's second statement ran would leave it.
	if _, err := db.Exec("UPDATE migrations SET running = -2 WHERE name = (SELECT name FROM (SELECT max(name) AS name FROM migrations) AS last)"); err != nil {
		t.Fatal(err)
	}
	ms, err := migrations()
	if err != nil {
		t.Fatal(err)
	}
	want := fmt.Sprintf("undoing migrations/%s.sql stopped at the statement 2 of its down part", ms[len(ms)-1].Name)
	if err := upToDate(t.Context(), db); err == nil || !strings.HasPrefix(err.Error(), want) {
		t.Errorf("starting again: %v, want %q", err, want)
	}
}

func TestAStepUnderWayInAnAppMadeBeforeIsNamedNotGuessed(t *testing.T) {
	db := newDB(t)()
	oldCount(t, db, 3)
	if _, err := db.Exec("UPDATE schema_version SET running = 4"); err != nil {
		t.Fatal(err)
	}
	if err := upToDate(t.Context(), db); err == nil || !strings.HasPrefix(err.Error(), "migration 4 was under way when the app stopped") {
		t.Errorf("starting: %v", err)
	}
}
