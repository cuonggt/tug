package main

import (
	"context"
	"database/sql"
	"time"
)

// broadcasts carries the hub's events between the app's instances, in a
// table each one reads what's new from, every quarter of a second: a
// broadcast.Store, for the broadcast.Hub main makes. A row written in a
// transaction is there as it commits, so an event published with what it's
// about goes with it, or not at all: see in. An event is kept a minute,
// for every instance to read, and prune deletes it after.
type broadcasts struct {
	db   *sql.DB
	exec dbtx // what Publish goes through: the database, or a handler's transaction
}

// in is the broadcasts as tx publishes them, for Hub.In: they go as tx
// commits.
func (bs *broadcasts) in(tx *sql.Tx) *broadcasts {
	return &broadcasts{db: bs.db, exec: tx}
}

func (bs *broadcasts) Publish(ctx context.Context, event []byte) error {
	through := bs.exec
	if through == nil {
		through = bs.db
	}
	_, err := through.ExecContext(ctx, "INSERT INTO broadcasts (event, created_at) VALUES (?, ?)", event, time.Now().UnixMilli())
	return err
}

// pollEvery is how often Listen reads what's new.
var pollEvery = 250 * time.Millisecond

// gapWait is how long Listen waits for an event whose ID it hasn't read,
// below one it has: longer than a transaction that publishes one lasts.
const gapWait = 10 * time.Second

// Listen reads the events written since it began, every quarter of a
// second. MySQL hands out an ID as a row is written, not as it commits,
// so a transaction's may come after a later ID that another committed
// first, a rolled-back row's never comes, and a server that counts by
// more than one, as one of several primaries does, leaves IDs out: an ID
// below the highest read is waited for, gapWait from when it was first
// missed, then passed over, and each event is handed on once, whatever
// order its ID comes in.
func (bs *broadcasts) Listen(ctx context.Context, deliver func([]byte)) error {
	var last int64 // every event to it has been handed on, or passed over
	if err := bs.db.QueryRowContext(ctx, "SELECT COALESCE(MAX(id), 0) FROM broadcasts").Scan(&last); err != nil {
		return err
	}
	highest := last                  // the highest ID read
	seen := map[int64]bool{}         // the IDs above last handed on
	missing := map[int64]time.Time{} // those below highest not read, and when they were first missed
	tick := time.NewTicker(pollEvery)
	defer tick.Stop()
	for {
		select {
		case <-ctx.Done():
			return ctx.Err()
		case <-tick.C:
		}
		rows, err := bs.db.QueryContext(ctx, "SELECT id, event FROM broadcasts WHERE id > ? ORDER BY id", last)
		if err != nil {
			return err
		}
		for rows.Next() {
			var id int64
			var event []byte
			if err := rows.Scan(&id, &event); err != nil {
				rows.Close()
				return err
			}
			if !seen[id] {
				seen[id] = true
				delete(missing, id)
				deliver(event)
			}
			highest = max(highest, id)
		}
		if err := rows.Err(); err != nil {
			return err
		}
		now := time.Now()
		for id := last + 1; id < highest; id++ {
			if _, ok := missing[id]; !ok && !seen[id] {
				missing[id] = now
			}
		}
		for last < highest {
			next := last + 1
			if first, ok := missing[next]; ok {
				if now.Sub(first) < gapWait {
					break
				}
				delete(missing, next) // rolled back, or its transaction outlasted the wait
			}
			delete(seen, next)
			last = next
		}
	}
}

// prune deletes the events over a minute old, which every instance has
// read. It's a job, which newApp schedules for every minute.
func (bs *broadcasts) prune(ctx context.Context, _ struct{}) error {
	_, err := bs.db.ExecContext(ctx, "DELETE FROM broadcasts WHERE created_at <= ?", time.Now().Add(-time.Minute).UnixMilli())
	return err
}
