package main

import (
	"bytes"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
	"testing/fstest"

	"github.com/cuonggt/tug"
	"github.com/cuonggt/tug/tugtest"
)

// newClient is a browser with the app open, which the tests use as
// Inertia's client in it does: its visits get the pages as JSON, so the
// tests run without a frontend build. See package tugtest.
func newClient(t *testing.T) *tugtest.Client {
	app, err := newApp(tug.Config{}, fstest.MapFS{}, [][]byte{bytes.Repeat([]byte{1}, 32)}[[ if .SSR ]], fstest.MapFS{}[[ end ]])
	if err != nil {
		t.Fatal(err)
	}
	return tugtest.New(t, app)
}

func TestTheAppSaysItsUp(t *testing.T) {
	// What a load balancer, or whatever watches the app, asks for.
	app, err := newApp(tug.Config{}, fstest.MapFS{}, [][]byte{bytes.Repeat([]byte{1}, 32)}[[ if .SSR ]], fstest.MapFS{}[[ end ]])
	if err != nil {
		t.Fatal(err)
	}
	rec := httptest.NewRecorder()
	app.ServeHTTP(rec, httptest.NewRequest("GET", "/up", nil))
	if rec.Code != http.StatusOK || rec.Body.String() != "up" {
		t.Errorf("GET /up: %d %q", rec.Code, rec.Body.String())
	}
}

func TestTheHomePageGreets(t *testing.T) {
	r := newClient(t).Get("/")
	if home := tugtest.Props(r, Home); !strings.HasPrefix(home.Greeting, "This page was rendered by Go") {
		t.Fatalf("got %v, greeting %q", r, home.Greeting)
	}
}

func TestSayingHelloWithoutANameComesBackWithWhatToFix(t *testing.T) {
	c := newClient(t)
	c.Get("/")
	r := c.Post("/hello", map[string]any{"name": ""})
	if r.Code != http.StatusSeeOther || r.Location() != "/" {
		t.Fatalf("got %v, want back to the form", r)
	}
	if errs := r.Follow().Errors(); errs["name"] != "name is required" {
		t.Fatalf("errors %v", errs)
	}
}

func TestSayingHelloIsAnsweredOnTheNextPage(t *testing.T) {
	c := newClient(t)
	c.Get("/")
	if r := c.Post("/hello", map[string]any{"name": "Ann"}).Follow(); r.Page.Flash["success"] != "Hello, Ann!" {
		t.Fatalf("flash %v", r.Page.Flash)
	}
}
