<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
[[- if .SSR ]]
    {{/* What the page rendered on the server puts in the head, its own
         <title> first: the one after it is for a page without one. */}}
    {{ .InertiaHead }}
[[- end ]]
    <title data-inertia>[[ .Name ]]</title>
    <link rel="icon" href="data:,">
    {{/* The scripts carry the page's nonce, which its policy runs scripts
         by, and the page's own component loads alongside the app, not
         after it. */}}
[[- if .React ]]
    {{ viteReactRefresh .Nonce }}
[[- end ]]
    {{ vite .Nonce "resources/js/app.[[ .Script ]]" (printf "resources/js/pages/%s.[[ .Component ]]" .Page.Component) }}
  </head>
  <body>
    {{ .Inertia }}
  </body>
</html>
