# Copy to .env, which tug dev reads. APP_KEY encrypts the sessions: make one
# with `head -c 32 /dev/urandom | base64`, and write it as base64:<that>.
APP_KEY=
APP_DEBUG=true
[[ if .SSR -]]

# Pages render on the server with Node, which the app runs beside it: the
# node on PATH, or the one SSR_NODE names. SSR_URL names an SSR server run
# apart instead, such as http://127.0.0.1:13714, and the app runs none.
SSR_NODE=
SSR_URL=
[[ end -]]
