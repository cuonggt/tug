# Copy to .env, which tug dev reads. APP_KEY encrypts the sessions: make one
# with `head -c 32 /dev/urandom | base64`, and write it as base64:<that>.
APP_KEY=
APP_DEBUG=true

# The app's own address, where links to it from elsewhere start, such as
# https://example.com: tug dev sets it to where it shows the app. With
# https://, the session cookie is for HTTPS only.
APP_URL=

# The language a browser gets that asks for none of the app's: English,
# or one with a file in lang/, as tug lang vi writes lang/vi.json.
APP_LOCALE=en

# The proxies in front of the app, such as a load balancer, whose
# X-Forwarded-For says whose each request is: addresses or ranges, comma
# separated, as 10.0.0.0/8, or * for whatever connects, on a platform that
# nothing but its proxy can reach the app on. Without them, a request is
# from whatever connected.
TRUSTED_PROXIES=
[[ if .SSR -]]

# Pages render on the server with Node, which the app runs beside it: the
# node on PATH, or the one SSR_NODE names. SSR_URL names an SSR server run
# apart instead, such as http://127.0.0.1:13714, and the app runs none.
SSR_NODE=
SSR_URL=
[[ end -]]
