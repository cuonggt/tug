# Copy to .env, which tug dev reads. APP_KEY encrypts the sessions: tug key
# makes one.
APP_KEY=
APP_DEBUG=true

# The app's own address, where links to it from elsewhere start, such as
# https://example.com: tug dev sets it to where it shows the app. With
# https://, the session cookie is for HTTPS only.
APP_URL=

# The language a browser gets that asks for none of the app's: English,
# or one with a file in lang/, as tug lang vi writes lang/vi.json.
APP_LOCALE=en

# The time zone the app's pages write their times in, an IANA name such as
# Asia/Ho_Chi_Minh. Empty is UTC. A page writes a time in the reader's own
# zone once it's open in their browser.
APP_TIMEZONE=

# The proxies in front of the app, such as a load balancer, whose
# X-Forwarded-For says whose each request is: addresses or ranges, comma
# separated, as 10.0.0.0/8, or * for whatever connects, on a platform that
# nothing but its proxy can reach the app on. Without them, a request is
# from whatever connected.
TRUSTED_PROXIES=

# The app serves HTTPS itself, on a machine of its own with no proxy in
# front to end TLS: with TLS_DOMAINS, comma separated, as
# example.com,www.example.com, which APP_URL's host is one of, it gets a
# certificate for each from Let's Encrypt, whose terms setting it accepts,
# kept in CERTS_PATH, and serves HTTPS on :443, or ADDR, and HTTP on :80, or
# HTTP_ADDR, which sends every request to HTTPS. ACME_URL is another CA,
# as Let's Encrypt's staging,
# https://acme-staging-v02.api.letsencrypt.org/directory, to try a deploy
# without spending Let's Encrypt's limits. TLS_CERT and TLS_KEY are a
# certificate of the app's own instead, files, read again as they change.
# tug dev leaves them out, and serves HTTP.
TLS_DOMAINS=
CERTS_PATH=certs
ACME_URL=
TLS_CERT=
TLS_KEY=
HTTP_ADDR=
[[ if .SSR -]]

# Pages render on the server with Node, which the app runs beside it: the
# node on PATH, or the one SSR_NODE names. SSR_URL names an SSR server run
# apart instead, such as http://127.0.0.1:13714, and the app runs none.
SSR_NODE=
SSR_URL=
[[ end -]]
